<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ================================================================ -->
<!-- LANDING PAGE - BLUE VARIANT                                      -->
<!-- Přepisuje oranžové/warm barvy na modré                           -->
<!-- ================================================================ -->
<template id="hh_page_landing_blue" name="Honza Hauzr Landing (Blue)">
    <t t-call="website.layout">
        <t t-set="no_header" t-value="True"/>
        <t t-set="no_footer" t-value="True"/>
        <t t-set="additional_title">Honza Hauzr | Začni žít naplno</t>
        <t t-set="meta_description">Honza Hauzr pomáhá lidem žít plnohodnotnější život. Osobní rozvoj, koučink a mentoring.</t>

        <!-- Inline style override: orange -> blue -->
        <style>
            .hh-landing.hh-blue {
                --hh-warm: #4a90d9;
                --hh-warm-light: #6bb5ff;
                --hh-red: #3a7bd5;
                --hh-green: #44ddff;
                --hh-gold: #6bb5ff;
                --hh-gradient-warm: linear-gradient(135deg, #4a90d9 0%, #00c6ff 100%);
                --hh-gradient-sunset: linear-gradient(135deg, #4a90d9 0%, #6bb5ff 100%);
            }
            /* Buttons */
            .hh-blue .hh-btn--primary {
                background: linear-gradient(135deg, #4a90d9 0%, #00c6ff 100%);
                box-shadow: 0 4px 24px rgba(74, 144, 217, 0.3);
            }
            .hh-blue .hh-btn--primary:hover {
                box-shadow: 0 8px 40px rgba(74, 144, 217, 0.5);
            }
            .hh-blue .hh-btn--warm {
                background: linear-gradient(135deg, #4a90d9 0%, #6bb5ff 100%);
                box-shadow: 0 4px 24px rgba(74, 144, 217, 0.3);
            }
            .hh-blue .hh-btn--warm:hover {
                box-shadow: 0 8px 40px rgba(74, 144, 217, 0.5);
            }
            .hh-blue .hh-btn--ghost:hover {
                border-color: rgba(74, 144, 217, 0.4);
            }
            /* Badges */
            .hh-blue .hh-badge--warm {
                background: rgba(74, 144, 217, 0.15);
                color: #4a90d9;
                border-color: rgba(74, 144, 217, 0.3);
            }
            .hh-blue .hh-badge--red {
                background: rgba(58, 123, 213, 0.15);
                color: #3a7bd5;
                border-color: rgba(58, 123, 213, 0.3);
            }
            .hh-blue .hh-badge--green {
                background: rgba(68, 221, 255, 0.15);
                color: #44ddff;
                border-color: rgba(68, 221, 255, 0.3);
            }
            /* Text gradients */
            .hh-blue .hh-text-gradient-warm {
                background: linear-gradient(135deg, #4a90d9 0%, #00c6ff 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }
            /* Hero */
            .hh-blue .hh-hero h1 em {
                background: linear-gradient(135deg, #4a90d9 0%, #00c6ff 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }
            .hh-blue .hh-hero__scroll-line {
                background: linear-gradient(180deg, rgba(74, 144, 217, 0.6), transparent);
            }
            /* Pain section icons */
            .hh-blue .hh-pain__item-icon {
                background: rgba(58, 123, 213, 0.12);
            }
            /* Transform stats */
            .hh-blue .hh-transform__stat strong {
                background: linear-gradient(135deg, #4a90d9 0%, #00c6ff 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }
            .hh-blue .hh-transform__content .lead {
                color: #4a90d9;
            }
            /* Offer */
            .hh-blue .hh-offer {
                background: linear-gradient(180deg, var(--hh-bg) 0%, rgba(74, 144, 217, 0.03) 50%, var(--hh-bg) 100%);
            }
            .hh-blue .hh-offer__card:hover {
                border-color: rgba(74, 144, 217, 0.3);
            }
            .hh-blue .hh-offer__card-icon {
                background: rgba(74, 144, 217, 0.12);
            }
            .hh-blue .hh-offer__main-content .lead {
                color: #4a90d9;
            }
            /* Process */
            .hh-blue .hh-process__step-num {
                background: linear-gradient(135deg, #4a90d9 0%, #00c6ff 100%);
            }
            /* Testimonials */
            .hh-blue .hh-testimonial:hover {
                border-color: rgba(74, 144, 217, 0.2);
            }
            /* Final CTA */
            .hh-blue .hh-final-cta__urgency {
                background: rgba(74, 144, 217, 0.15);
                border-color: rgba(74, 144, 217, 0.3);
                color: #4a90d9;
            }
            .hh-blue .hh-form input:focus,
            .hh-blue .hh-form textarea:focus,
            .hh-blue .hh-form select:focus {
                border-color: rgba(74, 144, 217, 0.6);
            }
            /* Sticky CTA */
            .hh-blue .hh-sticky-cta {
                border-top-color: rgba(74, 144, 217, 0.3);
            }
        </style>

        <div id="wrap" class="oe_structure oe_empty hh-landing hh-blue">

            <!-- 1. HERO -->
            <section class="hh-hero o_cc o_colored_level" id="hero" style="background-image: url('/theme_honzahauzr/static/src/img/content/hero-sunset.jpg'); background-size: cover; background-position: center;">
                <div class="hh-hero__bg"/>
                <div class="container">
                    <div class="hh-hero__content">
                        <p class="hh-hero__tagline anim-visible" data-anim="fade-up">
                            Osobní rozvoj &#8226; Koučink &#8226; Mentoring
                        </p>
                        <h1 data-anim="fade-up" data-delay="150" class="anim-visible">
                            Začni žít život,<br/>který <em>stojí za to</em>
                        </h1>
                        <p class="hh-hero__sub anim-visible" data-anim="fade-up" data-delay="300">
                            Pomáhám lidem najít odvahu změnit to, co jim nefunguje. Protože
                            každý si zaslouží cítit se živě.
                        </p>
                        <div class="hh-hero__ctas anim-visible" data-anim="fade-up" data-delay="450">
                            <a href="#kontakt" class="hh-btn hh-btn--primary hh-btn--large">Chci bezplatnou konzultaci</a>
                            <a href="#o-mne" class="hh-btn hh-btn--ghost">Zjistit víc</a>
                        </div>
                    </div>
                </div>
                <div class="hh-hero__scroll">
                    Scrolluj
                    <div class="hh-hero__scroll-line"/>
                </div>
            </section>

            <!-- 2. VISION STRIP -->
            <section class="hh-vision-strip o_cc o_colored_level" data-snippet="s_hh_vision_strip" data-name="HH Vision Strip">
                <div class="hh-vision-strip__photos">
                    <div class="hh-vision-strip__photo-wrap oe_img_bg o_bg_img_center" style="background-image: url('/theme_honzahauzr/static/src/img/content/vision-mountains.jpg'); background-size: cover; background-position: center;"/>
                    <div class="hh-vision-strip__photo-wrap oe_img_bg o_bg_img_center" style="background-image: url('/theme_honzahauzr/static/src/img/content/vision-friends.jpg'); background-size: cover; background-position: center;"/>
                    <div class="hh-vision-strip__photo-wrap oe_img_bg o_bg_img_center" style="background-image: url('/theme_honzahauzr/static/src/img/content/vision-freefall.jpg'); background-size: cover; background-position: center;"/>
                </div>
                <div class="hh-vision-strip__overlay o_cc o_colored_level">
                    <div class="hh-vision-strip__text">
                        <h2 data-anim="fade-up">
                            Takhle vypadá život,<br/>který si
                            <span class="hh-text-gradient-warm">zasloužíš</span>
                        </h2>
                        <p data-anim="fade-up" data-delay="200">
                            Ne za 10 let. Ne až bude správný čas.<br/>Teď. A já ti ukážu jak.
                        </p>
                    </div>
                </div>
            </section>

            <!-- 3. PAIN -->
            <section class="hh-pain o_cc o_colored_level">
                <div class="container">
                    <div class="hh-pain__grid">
                        <div class="hh-pain__visual d-none d-lg-block anim-visible" data-anim="fade-right">
                            <img src="/web/image/604-191996f8/DSC_0079.webp" alt="" class="img-fluid w-100 rounded-4 img o_we_custom_image" style="object-fit: cover; height: 400px;" data-mimetype="image/webp" data-original-id="603" data-original-src="/web/image/603-18c51f7f/DSC_0079.JPG" data-mimetype-before-conversion="image/jpeg" data-resize-width="690"/>
                        </div>
                        <div class="hh-pain__content">
                            <span class="hh-badge hh-badge--red anim-visible" data-anim="fade-up">Poznej pravdu</span>
                            <h2 style="margin-top: 20px;" data-anim="fade-up" data-delay="100" class="anim-visible">
                                Většina lidí žije<br/>na
                                <span class="hh-text-gradient-warm">autopilotu</span>
                            </h2>
                            <div class="d-lg-none" style="margin: 24px 0;" data-anim="fade-up" data-delay="150">
                                <img src="/web/image/604-191996f8/DSC_0079.webp" alt="" class="img-fluid w-100 rounded-4 img o_we_custom_image" style="object-fit: cover; height: 260px;" data-mimetype="image/webp" data-original-id="603" data-original-src="/web/image/603-18c51f7f/DSC_0079.JPG" data-mimetype-before-conversion="image/jpeg" data-resize-width="690"/>
                            </div>
                            <div class="hh-pain__item anim-visible" data-anim="fade-left" data-delay="200">
                                <div class="hh-pain__item-icon" style="background: rgba(58, 123, 213, 0.12)">
                                    <i class="fa fa-frown-o" style="font-size: 20px; color: #3a7bd5;"/>
                                </div>
                                <div>
                                    <h3>Cítíš, že by to mohlo být jinak</h3>
                                    <p>Máš všechno co "bys měl" — ale radost chybí.</p>
                                </div>
                            </div>
                            <div class="hh-pain__item anim-visible" data-anim="fade-left" data-delay="300">
                                <div class="hh-pain__item-icon" style="background: rgba(74, 144, 217, 0.12)">
                                    <i class="fa fa-clock-o" style="font-size: 20px; color: #5a9fd4;"/>
                                </div>
                                <div>
                                    <h3>Den za dnem stejný kolotoč</h3>
                                    <p>Práce, domov, spánek, opakuj. Kde je smysl?</p>
                                </div>
                            </div>
                            <div class="hh-pain__item anim-visible" data-anim="fade-left" data-delay="400">
                                <div class="hh-pain__item-icon" style="background: rgba(107, 181, 255, 0.12)">
                                    <i class="fa fa-question-circle-o" style="font-size: 20px; color: #6bb5ff;"/>
                                </div>
                                <div>
                                    <h3>"Co vlastně chci?" — bez odpovědí</h3>
                                    <p>Bez jasného směru se točíš v kruhu a energie ubývá.</p>
                                </div>
                            </div>
                            <div style="margin-top: 32px;" data-anim="fade-up" data-delay="500" class="anim-visible">
                                <a href="#kontakt" class="hh-btn hh-btn--warm">Chci to změnit</a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 4. TRANSFORMATION -->
            <section class="hh-transform o_cc o_colored_level" id="o-mne" style="background-image: url('/theme_honzahauzr/static/src/img/content/honza-mountain-selfie.jpg'); background-size: cover; background-position: center top;">
                <div class="hh-transform__gradient"/>
                <div class="container">
                    <div class="hh-transform__content">
                        <span class="hh-badge hh-badge--green" data-anim="fade-up">Kdo jsem</span>
                        <h2 style="margin-top: 20px" data-anim="fade-up" data-delay="100">
                            Jsem <span class="hh-text-gradient-warm">Honza Hauzr</span>
                        </h2>
                        <p class="lead" data-anim="fade-up" data-delay="200">
                            Věřím, že každý člověk má v sobě obrovský potenciál. Někdy stačí jen
                            někdo, kdo ti pomůže ho odhalit.
                        </p>
                        <p data-anim="fade-up" data-delay="300">
                            Sám jsem si prošel tou cestou. Věděl jsem, že chci víc — ale
                            nevěděl jsem jak. Dnes žiju život, o kterém jsem snil, a pomáhám
                            ostatním udělat to samé.
                        </p>
                        <p data-anim="fade-up" data-delay="350">
                            Ne teorii z knih. Reálné zkušenosti, které fungujou. Pracuji s lidmi
                            individuálně — protože každá cesta je unikátní.
                        </p>
                        <div class="hh-transform__stats" data-anim="fade-up" data-delay="450">
                            <div class="hh-transform__stat">
                                <strong data-anim="counter" data-count="200">0</strong>
                                <span>klientů</span>
                            </div>
                            <div class="hh-transform__stat">
                                <strong data-anim="counter" data-count="5">0</strong>
                                <span>let praxe</span>
                            </div>
                            <div class="hh-transform__stat">
                                <strong data-anim="counter" data-count="50">0</strong>
                                <span>workshopů</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 5. OFFER -->
            <section class="hh-offer o_cc o_colored_level">
                <div class="container">
                    <div class="hh-offer__header">
                        <span class="hh-badge hh-badge--warm anim-visible" data-anim="fade-up">Co nabízím</span>
                        <h2 style="margin-top: 20px;" data-anim="fade-up" data-delay="100" class="anim-visible">
                            Individuální spolupráce<br/><span class="hh-text-gradient-warm">přímo s tebou</span>
                        </h2>
                        <p data-anim="fade-up" data-delay="200" class="anim-visible">
                            Žádné masovky. Žádný one-size-fits-all. Jen ty, já a tvá cesta.
                        </p>
                    </div>
                    <div class="hh-offer__main">
                        <div class="hh-offer__main-photo anim-visible" data-anim="fade-right">
                            <img src="/web/image/601-e446d085/IMG_20190622_143325.webp" alt="" class="img-fluid w-100 rounded-4 img o_we_custom_image" style="object-fit: cover; height: 440px;" data-mimetype="image/webp" data-original-id="598" data-original-src="/web/image/598-fcad1c4c/IMG_20190622_143325.jpg" data-mimetype-before-conversion="image/jpeg" data-resize-width="690"/>
                        </div>
                        <div class="hh-offer__main-content">
                            <h3 data-anim="fade-left" data-delay="100" class="anim-visible">Osobní koučink 1 na 1</h3>
                            <p class="lead anim-visible" data-anim="fade-left" data-delay="200">
                                Společně rozebereme, co tě drží zpátky, a nastavíme konkrétní kroky dopředu.
                            </p>
                            <p data-anim="fade-left" data-delay="250" class="anim-visible">
                                Každý program je na míru — protože tvůj život není šablona.
                            </p>
                            <ul class="hh-offer__includes anim-visible" data-anim="fade-left" data-delay="300">
                                <li><i class="fa fa-check" style="color: #44ddff;" contenteditable="false">&#8203;</i> Bezplatná úvodní konzultace (30 min)</li>
                                <li><i class="fa fa-check" style="color: #44ddff;" contenteditable="false">&#8203;</i> Plán na míru podle tvých cílů</li>
                                <li><i class="fa fa-check" style="color: #44ddff;" contenteditable="false">&#8203;</i> Pravidelná sezení online nebo v Praze/Brně</li>
                                <li><i class="fa fa-check" style="color: #44ddff;" contenteditable="false">&#8203;</i> Podpora mezi sezeními přes chat</li>
                            </ul>
                            <div data-anim="fade-up" data-delay="400" class="anim-visible">
                                <a href="#kontakt" class="hh-btn hh-btn--primary hh-btn--large">Chci začít</a>
                            </div>
                        </div>
                    </div>
                    <div class="hh-offer__more">
                        <div class="hh-offer__card anim-visible" data-anim="fade-up" data-delay="100">
                            <div class="hh-offer__card-icon">
                                <i class="fa fa-users" style="font-size: 26px; color: #4a90d9;" contenteditable="false">&#8203;</i>
                            </div>
                            <h4>Skupinový program</h4>
                            <p>8týdenní program v malé skupině. Sdílená energie a strukturovaný proces změny.</p>
                        </div>
                        <div class="hh-offer__card anim-visible" data-anim="fade-up" data-delay="250">
                            <div class="hh-offer__card-icon">
                                <i class="fa fa-calendar" style="font-size: 26px; color: #4a90d9;" contenteditable="false">&#8203;</i>
                            </div>
                            <h4>Workshopy a přednášky</h4>
                            <p>Jednodenní akce na konkrétní témata — stres, návyky, smysl života.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 6. PROCESS -->
            <section class="hh-process o_cc o_colored_level">
                <div class="container">
                    <div class="hh-process__header">
                        <span class="hh-badge hh-badge--green anim-visible" data-anim="fade-up">Jak to funguje</span>
                        <h2 style="margin-top: 20px;" data-anim="fade-up" data-delay="100" class="anim-visible">
                            3 kroky k <span class="hh-text-gradient-warm">tvé změně</span>
                        </h2>
                    </div>
                    <div class="hh-process__steps">
                        <div class="hh-process__step anim-visible" data-anim="fade-up" data-delay="100">
                            <div class="hh-process__step-photo">
                                <img src="/web/image/593-7dc95b3f/vepr.webp" alt="" class="img-fluid w-100 rounded-4 img o_we_custom_image" style="object-fit: cover; height: 200px;" data-mimetype="image/webp" data-original-id="590" data-original-src="/web/image/590-7e8ab402/vepr.jpg" data-mimetype-before-conversion="image/jpeg" data-resize-width="690" loading="lazy"/>
                            </div>
                            <div class="hh-process__step-num">1</div>
                            <h3>První konzultace zdarma</h3>
                            <p>Podíváme se, kde jsi a kam chceš. Bez závazků, bez tlaku.</p>
                        </div>
                        <div class="hh-process__step anim-visible" data-anim="fade-up" data-delay="250">
                            <div class="hh-process__step-photo">
                                <img src="/web/image/597-e8a4b1a0/IMG_3059.webp" alt="" class="img-fluid w-100 rounded-4 img o_we_custom_image" style="object-fit: cover; height: 200px;" data-mimetype="image/webp" data-original-id="596" data-original-src="/web/image/596-dc4718d2/IMG_3059.jpg" data-mimetype-before-conversion="image/jpeg" data-resize-width="690"/>
                            </div>
                            <div class="hh-process__step-num">2</div>
                            <h3>Plán na míru</h3>
                            <p>Společně vytvoříme konkrétní plán — co změnit, jak a kdy.</p>
                        </div>
                        <div class="hh-process__step anim-visible" data-anim="fade-up" data-delay="400">
                            <div class="hh-process__step-photo">
                                <img src="/web/image/594-a8197d31/crazy.webp" alt="" class="img-fluid w-100 rounded-4 img o_we_custom_image" style="object-fit: cover; height: 200px;" data-mimetype="image/webp" data-original-id="592" data-original-src="/web/image/592-a43db516/crazy.jpg" data-mimetype-before-conversion="image/jpeg" data-resize-width="690" loading="lazy"/>
                            </div>
                            <div class="hh-process__step-num">3</div>
                            <h3>Realizace a podpora</h3>
                            <p>Provázím tě celou cestou. Pravidelná sezení a slavení pokroku.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 7. TESTIMONIALS -->
            <section class="hh-testimonials o_cc o_colored_level">
                <div class="container">
                    <div class="hh-testimonials__header">
                        <span class="hh-badge hh-badge--warm anim-visible" data-anim="fade-up">Ohlasy</span>
                        <h2 style="margin-top: 20px;" data-anim="fade-up" data-delay="100" class="anim-visible">
                            Co říkají <span class="hh-text-gradient-warm">lidé, kteří prošli změnou</span>
                        </h2>
                    </div>
                    <div class="hh-testimonials__grid">
                        <div class="hh-testimonial anim-visible" data-anim="fade-up" data-delay="100">
                            <div class="hh-testimonial__stars">
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                            </div>
                            <p class="hh-testimonial__text">"S Honzou jsem během 3 měsíců změnila práci a konečně
                                se cítím jako já sama. Nejlepší investice do sebe."</p>
                            <div class="hh-testimonial__author">
                                <strong>Petra K.</strong>Marketing Manager
                            </div>
                        </div>
                        <div class="hh-testimonial anim-visible" data-anim="fade-up" data-delay="250">
                            <div class="hh-testimonial__stars">
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                            </div>
                            <p class="hh-testimonial__text">"Po 2 měsících jsem konečně věděl, co chci od života
                                a měl jsem odvahu to udělat."</p>
                            <div class="hh-testimonial__author">
                                <strong>Tomáš M.</strong>Software Developer
                            </div>
                        </div>
                        <div class="hh-testimonial anim-visible" data-anim="fade-up" data-delay="400">
                            <div class="hh-testimonial__stars">
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                                <i class="fa fa-star" style="color: #6bb5ff;" contenteditable="false">&#8203;</i>
                            </div>
                            <p class="hh-testimonial__text">"Honza má dar — umí klást otázky, na které si sama
                                nedokážete odpovědět. Ty odpovědi vám změní život."</p>
