            <section data-name="Newsletter" class="hh-news o_cc o_colored_level" id="newsletter">
                <div class="container">
                    <div class="hh-news__box" data-anim="fade-up">
                        <div class="hh-news__text">
                            <h3>Chceš zůstat v kontaktu?</h3>
                            <p>
                                Jednou za čas ti pošlu konkrétní myšlenku, otázku nebo tip, který ti
                                pomůže vystoupit z autopilota a žít víc podle sebe.
                            </p>
                        </div>
                        <form class="hh-news__form s_website_form"
                              action="/website/form/" method="post" enctype="multipart/form-data"
                              data-model_name="crm.lead"
                              data-success-mode="message">
                            <input type="hidden" name="name" value="Newsletter z webu honzahauzr.cz"/>
                            <input type="hidden" name="hh_zdroj" value="newsletter"/>
                            <div class="s_website_form_field s_website_form_required">
                                <label class="col-form-label s_website_form_label hh-sr-only" for="hhn_news_email">E-mail</label>
                                <input type="email" id="hhn_news_email" class="form-control s_website_form_input hh-news__input"
                                       name="email_from" placeholder="E-mail" required="required"/>
                                <span class="hh-err">Bez e-mailu ti nemám co poslat.</span>
                            </div>
                            <button type="submit" class="hh-btn s_website_form_send">Chci odebírat</button>
                        </form>
                        <div class="s_website_form_end_message d-none hh-done hh-done--inline">
                            <div class="hh-done__icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>
                            </div>
                            <p>Mám to. Ozvu se, až budu mít co říct.</p>
                        </div>
                    </div>
                </div>
            </section>

