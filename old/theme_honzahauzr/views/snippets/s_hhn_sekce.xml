    <section class="hhn-jak o_cc o_colored_level" id="jak-pracuji">
        <div class="container">
            <div class="hhn-head-center">
                <span class="hhn-eyebrow hhn-eyebrow--accent" data-anim="fade-up">Jak pracuji</span>
                <h2 class="hhn-h2" data-anim="fade-up" data-delay="100">
                    Tvoje cesta začíná u toho,<br/>
                    <span class="hhn-accent">co můžeš ovlivnit.</span>
                </h2>
            </div>
            <!-- Stejny vzhled jako karty problemu vyse: vetsi ikona,
                 nazev a pod nim vysvetlujici text. Snippet musi dat
                 to same, co uz na strance stoji. -->
            <div class="hhn-pillars">
                <div class="hhn-pillar o_snippet_drop_in_only" data-anim="fade-up" data-delay="140">
                    <div class="hhn-pillar__icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 4.5H3.5v11h4v4l4.5-4h8.5z"/></svg>
                    </div>
                    <h3>Pravda místo výmluv</h3>
                    <p>Pojmenujeme věci tak, jak jsou. Bez obalu, ale s respektem.</p>
                </div>
                <div class="hhn-pillar o_snippet_drop_in_only" data-anim="fade-up" data-delay="210">
                    <div class="hhn-pillar__icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7.5" r="3.6"/><path d="M4.8 20a7.2 7.2 0 0 1 14.4 0"/></svg>
                    </div>
                    <h3>Odpovědnost místo čekání</h3>
                    <p>Přestaneš čekat, že se něco změní samo, a vezmeš život do svých rukou.</p>
                </div>
                <div class="hhn-pillar o_snippet_drop_in_only" data-anim="fade-up" data-delay="280">
                    <div class="hhn-pillar__icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 19.5v-5"/><path d="M9.5 19.5v-9"/><path d="M14.5 19.5V6"/><path d="M19.5 19.5v-12"/></svg>
                    </div>
                    <h3>Konkrétní kroky místo další teorie</h3>
                    <p>Žádná omáčka. Konkrétní kroky, které můžeš začít dělat hned.</p>
                </div>
                <div class="hhn-pillar o_snippet_drop_in_only" data-anim="fade-up" data-delay="350">
                    <div class="hhn-pillar__icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15.2 8.8 13.6 13.6 8.8 15.2l1.6-4.8z"/></svg>
                    </div>
                    <h3>Vlastní pravidla místo života podle očekávání okolí</h3>
                    <p>Přestaneš se snažit splňovat očekávání ostatních a začneš žít podle toho, co je důležité pro tebe.</p>
                </div>
            </div>
            <div class="hhn-center-action" data-anim="fade-up" data-delay="420">
                <t t-call="theme_honzahauzr.s_hhn_cta_odkaz"/>
                <p class="hhn-note hhn-cta-note">Bezplatná třídenní výzva Z autopilota zpět do života.</p>
            </div>
        </div>
    </section>
</template>

<!-- ===== 6. BEZPLATNA TRIDENNI VYZVA ===== -->
<!-- Jediny blok, ktery se barevne odchyluje: podle zadani uz jemne
     prechazi k piskove estetice Vlastni rezie, ve ktere bude cela
     landing page vyzvy. Odtud ta tepla vrstva a piskove akcenty. -->
<template id="s_hhn_vyzva" name="Bezplatná třídenní výzva">
    <section class="hhn-challenge o_cc o_colored_level" id="vyzva">
        <div class="hhn-challenge__photo"
             style="background-image: url('/theme_honzahauzr/static/src/img/vyzva-blok.webp');"/>
        <div class="hhn-challenge__veil"/>
        <div class="container">
            <div class="hhn-challenge__head">
                <span class="hhn-eyebrow hhn-eyebrow--sand" data-anim="fade-up">Bezplatná třídenní výzva</span>
                <h2 class="hhn-h2" data-anim="fade-up" data-delay="100">
                    Začni tím, že zjistíš, kde dnes řídíš svůj život ty
                    &#8211; a kde za tebe rozhoduje autopilot.
                </h2>
                <p class="hhn-lead" data-anim="fade-up" data-delay="180">
                    V bezplatné třídenní výzvě Z autopilota zpět do života si pojmenuješ,
                    kde dnes jen automaticky funguješ, co tě drží na místě a jaký první
                    krok potřebuješ udělat.
                </p>
            </div>
            <div class="hhn-steps">
                <div class="hhn-step o_snippet_drop_in_only" data-anim="fade-up" data-delay="240">
                    <span class="hhn-step__num">1</span>
                    <div>
                        <h3>Zastavíš se</h3>
                        <p>Uděláš si upřímnou inventuru, kde se právě nacházíš.</p>
                    </div>
                </div>
                <div class="hhn-step o_snippet_drop_in_only" data-anim="fade-up" data-delay="300">
                    <span class="hhn-step__num">2</span>
                    <div>
                        <h3>Pojmenuješ svůj autopilot</h3>
                        <p>Uvidíš vzorce, které tě drží na místě.</p>
                    </div>
                </div>
                <div class="hhn-step o_snippet_drop_in_only" data-anim="fade-up" data-delay="360">
                    <span class="hhn-step__num">3</span>
                    <div>
                        <h3>Uděláš první vlastní krok</h3>
                        <p>Získáš konkrétní krok, který si odneseš dál.</p>
                    </div>
                </div>
            </div>
            <div class="hhn-challenge__action" data-anim="fade-up" data-delay="420">
                <t t-call="theme_honzahauzr.s_hhn_cta_odkaz"/>
                <p class="hhn-note hhn-cta-note">Bezplatná třídenní výzva Z autopilota zpět do života.</p>
            </div>
            <p class="hhn-note hhn-challenge__note" data-anim="fade" data-delay="480">
                3 dny &#8226; 3 videa &#8226; 3 konkrétní úkoly &#8226; žádné motivační kecy.
            </p>
        </div>
    </section>
</template>

<!-- ===== 7. NEWSLETTER ===== -->
<!-- Zamerne mensi a klidnejsi nez vyzva - vedlejsi moznost, ne druha
     hlavni nabidka. Zadne PDF, zadne vyskakovaci okno.
     Obal s_website_form_field je povinny - Odoo validuje jen vstupy
     uvnitr nej, bez nej projde i prazdny formular. -->
<template id="s_hhn_news" name="Newsletter">
    <section class="hh-news o_cc o_colored_level" id="newsletter">
        <div class="container">
            <div class="hh-news__box" data-anim="fade-up">
                <div class="hh-news__text">
                    <h3>Chceš zůstat v kontaktu?</h3>
                    <p>
                        Jednou za čas ti pošlu konkrétní myšlenku, otázku nebo tip, který ti
                        pomůže vystoupit z autopilota a žít víc podle sebe.
                    </p>
                </div>
                <form class="hh-news__form s_website_form"
                      action="/website/form/" method="post" enctype="multipart/form-data"
                      data-model_name="crm.lead"
                      data-success-mode="message">
                    <input type="hidden" name="name" value="Newsletter z webu honzahauzr.cz"/>
                    <input type="hidden" name="hh_zdroj" value="newsletter"/>
                    <div class="s_website_form_field s_website_form_required">
                        <label class="col-form-label s_website_form_label hh-sr-only" for="hhn_news_email">E-mail</label>
                        <input type="email" id="hhn_news_email" class="form-control s_website_form_input hh-news__input"
                               name="email_from" placeholder="E-mail" required="required"/>
                        <span class="hh-err">Bez e-mailu ti nemám co poslat.</span>
                    </div>
                    <button type="submit" class="hh-btn s_website_form_send">Chci odebírat</button>
                </form>
                <div class="s_website_form_end_message d-none hh-done hh-done--inline">
                    <div class="hh-done__icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>
                    </div>
                    <p>Mám to. Ozvu se, až budu mít co říct.</p>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- ===== 8. PATICKA ===== -->
<!-- Podle zadani jen kontaktni e-mail, socialni site a pravni odkazy.
     Zadne dalsi nabidky, zadna rezervace hovoru. -->
<template id="s_hhn_paticka" name="Patička">
