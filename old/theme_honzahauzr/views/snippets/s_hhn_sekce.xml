                <figure class="o_snippet_drop_in_only" data-anim="zoom-in" data-delay="240"><img src="/theme_honzahauzr/static/src/img/cesta-canyoning.webp" alt="Canyoning"/></figure>
                <figure class="o_snippet_drop_in_only" data-anim="zoom-in" data-delay="300"><img src="/theme_honzahauzr/static/src/img/content/vision-friends.jpg" alt="S přáteli"/></figure>
                <figure class="o_snippet_drop_in_only" data-anim="zoom-in" data-delay="360"><img src="/theme_honzahauzr/static/src/img/content/vision-freefall.jpg" alt="Volný pád"/></figure>
                <figure class="o_snippet_drop_in_only" data-anim="zoom-in" data-delay="420"><img src="/theme_honzahauzr/static/src/img/cesta-vychod.webp" alt="Východ slunce"/></figure>
