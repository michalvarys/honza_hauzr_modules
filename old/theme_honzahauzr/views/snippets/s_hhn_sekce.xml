<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ================================================================
     SEKCE NOVEHO DESIGNU JAKO SNIPPETY

     Kazda sekce uvodni stranky je samostatna sablona, kterou stranka
     (views/novy.xml) vola pres t-call. Markup tedy existuje jen jednou
     - co se zmeni tady, zmeni se i na strance a naopak.

     Drobne stavebni kameny (bod, pilir, krok, karta, fotka, tlacitko)
     jsou v s_hhn_polozky.xml a sekce je odsud volaji.

     Vsechny sekce jsou <section>, takze je editor umi pustit mezi
     ostatni bloky diky vestavenemu pravidlu Odoo. Zadne vlastni
     drop-zone pravidlo pro ne nepridavame - kolidovalo by s nim.
     ================================================================ -->

<!-- ===== 1. UVODNI OBRAZOVKA ===== -->
<template id="s_hhn_hero" name="Úvodní obrazovka">
    <section class="hhn-hero o_cc o_colored_level" id="uvod">
        <div class="hhn-hero__photo"
             style="background-image: url('/theme_honzahauzr/static/src/img/hero-balon.webp');"/>
        <div class="hhn-hero__veil"/>
        <div class="container">
            <div class="hhn-hero__content">
                <span class="hhn-eyebrow" data-anim="fade-up">
                    Osobní rozvoj &#8226; Koučink &#8226; Mentoring
                </span>
                <h1 data-anim="fade-up" data-delay="120">
                    Přestaň jen fungovat.<br/>Vezmi svůj život
                    <em>zpět do vlastní režie.</em>
                </h1>
                <p class="hhn-hero__sub" data-anim="fade-up" data-delay="240">
                    Pomáhám mužům, kteří navenek fungují, ale uvnitř vědí, že takhle
                    už nechtějí pokračovat, pochopit, co je drží na místě, nastavit
                    vlastní pravidla a udělat konkrétní další krok.
                </p>
                <div class="hhn-hero__action" data-anim="fade-up" data-delay="360">
                    <t t-call="theme_honzahauzr.s_hhn_cta_odkaz"/>
                </div>
                <p class="hhn-note hhn-hero__note" data-anim="fade" data-delay="440">
                    Bezplatná třídenní výzva Z autopilota zpět do života.
                </p>
            </div>
        </div>
    </section>
</template>

<!-- ===== 2. V CEM SE MUZE NAVSTEVNIK POZNAT ===== -->
<template id="s_hhn_poznani" name="V čem se poznáš">
    <section class="hhn-autopilot o_cc o_colored_level" id="poznani">
        <div class="container">
            <!-- Nadpis je vytazeny z praveho sloupce ven, aby se na mobilu
                 dal poslat nad fotku. Rozlozeni na obou sirkach ridi
                 mrizka v hh-novy.scss (oblasti nadpis / foto / obsah). -->
            <div class="hhn-split">
                <h2 class="hhn-h2 hhn-split__nadpis" data-anim="fade-up">
                    Možná nepotřebuješ začít znovu.<br/>
                    Potřebuješ přestat jet
                    <span class="hhn-accent">na autopilota.</span>
                </h2>
                <div class="hhn-split__photo" data-anim="fade-right">
                    <img src="/theme_honzahauzr/static/src/img/cesta-vychod.webp"
                         alt="Východ slunce nad horami"/>
                </div>
                <div class="hhn-split__content">
                    <!-- Ctyri karty problemu: ikona, kratky vyrazny nazev
                         a vysvetlujici text pod nim. Stejne jako na
                         uvodni strance - snippet musi dat to same, co
                         uz na strance stoji. -->
                    <div class="hhn-points">
                        <div class="hhn-point o_snippet_drop_in_only" data-anim="fade-up" data-delay="120">
                            <div class="hhn-point__icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 3 3 10.5l7 3 3 7z"/><path d="M10 13.5 21 3"/></svg>
                            </div>
                            <h3>Autopilot</h3>
                            <p>Všechno nějak funguje, ale na nic se pořádně netěšíš.</p>
                        </div>
                        <div class="hhn-point o_snippet_drop_in_only" data-anim="fade-up" data-delay="190">
                            <div class="hhn-point__icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 1.8"/></svg>
                            </div>
                            <h3>Odkládání</h3>
                            <p>Víš, co bys měl udělat, ale svoje rozhodnutí opakovaně odkládáš.</p>
                        </div>
                        <div class="hhn-point o_snippet_drop_in_only" data-anim="fade-up" data-delay="260">
                            <div class="hhn-point__icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17.5" cy="9.5" r="2.3"/><path d="M15.4 15.2a4.6 4.6 0 0 1 5.6 3.3"/></svg>
                            </div>
                            <h3>Hranice</h3>
                            <p>Ve vztazích ustupuješ, ztrácíš sebe nebo nedokážeš nastavit hranici.</p>
                        </div>
                        <div class="hhn-point o_snippet_drop_in_only" data-anim="fade-up" data-delay="330">
                            <div class="hhn-point__icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.6"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
                            </div>
                            <h3>Směr</h3>
                            <p>Navenek máš výsledky, ale chybí ti smysl a nevíš, co vlastně buduješ.</p>
                        </div>
                    </div>
                    <div class="hhn-split__action" data-anim="fade-up" data-delay="400">
                        <t t-call="theme_honzahauzr.s_hhn_cta_odkaz"/>
                        <p class="hhn-note hhn-cta-note">Bezplatná třídenní výzva Z autopilota zpět do života.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- ===== 3. MUJ PRIBEH - DRIV A DNES ===== -->
<template id="s_hhn_pribeh" name="Můj příběh (Dřív / Dnes)">
    <section class="hhn-pribeh o_cc o_colored_level" id="o-mne">
        <div class="container">
            <div class="hhn-story">
                <div class="hhn-story__text">
                    <span class="hhn-eyebrow hhn-eyebrow--accent" data-anim="fade-up">Můj příběh</span>
                    <h2 class="hhn-h2" style="margin-top: 16px" data-anim="fade-up" data-delay="100">
                        Znám život na autopilota<br/>
                        i cenu <span class="hhn-accent">změny.</span>
                    </h2>
                    <p data-anim="fade-up" data-delay="180">
                        Nemluvím z teorie z učebnice. Taky jsem dlouho fungoval
                        na autopilota. Unikal jsem do piva, cigaret a neustálého
                        rozptylování. Před sebou, před tím, co jsem cítil, i před
                        tím, co jsem měl udělat.
                    </p>
                    <p data-anim="fade-up" data-delay="240">
                        Až když jsem si začal říkat pravdu, začal jsem si držet
                        slovo, nastavovat hranice a dělat konkrétní změny. Nebylo
                        to snadné, ale stálo to za to.
                    </p>
                    <p class="hhn-zaver" data-anim="fade-up" data-delay="300">
                        Nemám všechno vyřešené. Jen už nečekám, až se můj život
                        změní sám.
                    </p>
                </div>

                <!-- Dve verze videa, ne jedna.

                     Klient dodava sirokouhle 16:9 na desktop a svisle
                     9:16 na mobil. Jeden prvek by to neuhral - pomer
                     se da prepnout pres CSS, ale zdroj videa ne. Jsou
                     tu proto oba a media dotaz vzdycky jeden schova.
                     Diky tomu se da kazdemu v editoru nastavit vlastni
                     adresa, aniz by to toho druheho ovlivnilo.

                     Bloky jsou zamerne prazdne. Ramecek do nich dosadi widget
                     mediaVideo z Odoo a adresu si bere z data-oe-expression.
                     Skript hh-video.js ten widget upravuje tak, aby schovanou
                     variantu nechal byt - jinak by se stahly obe.
                     -->
                <div class="hhn-video" data-anim="fade-left" data-delay="200" data-hhn-video-mobil="" data-hhv-popis="Video">
                            <div class="media_iframe_video o_snippet_drop_in_only" data-oe-expression="//www.youtube.com/embed/AqlcXZrmMNk?rel=0&amp;autoplay=0&amp;controls=1">
                        <div class="css_editable_mode_display"/>
                        <div class="media_iframe_video_size"/>
                    </div>
                        </div>
            </div>

            <!-- Oznaceni DRIV / DNES musi byt citelne samo o sobe, bez
                 dalsiho vysvetlovani - proto vyrazny stitek primo ve fotce. -->
            <div class="hhn-then-now">
                <div class="hhn-card o_snippet_drop_in_only" data-anim="fade-right">
                    <div class="hhn-card__photo">
                        <span class="hhn-tag hhn-tag--then">Dřív</span>
                        <img src="/theme_honzahauzr/static/src/img/pribeh-driv.webp" alt="Honza Hauzr dřív"/>
                    </div>
                    <h3>Utíkal jsem před sebou</h3>
                    <p>
                        Pivo, cigarety a výmluvy, proč to jinak nejde. Zvenku
                        pohoda, uvnitř útěk před sebou samým.
                    </p>
                </div>
                <div class="hhn-card o_snippet_drop_in_only" data-anim="fade-left" data-delay="120">
                    <div class="hhn-card__photo">
                        <span class="hhn-tag hhn-tag--now">Dnes</span>
                        <img src="/theme_honzahauzr/static/src/img/pribeh-dnes.webp" alt="Honza Hauzr dnes"/>
                    </div>
                    <h3>Vím, kam jdu</h3>
                    <p>
                        Žádné berličky. Vlastní pravidla, která jsem si
                        nastavil sám &#8211; a držím je.
                    </p>
                </div>
            </div>
            <p class="hhn-then-now__footnote" data-anim="fade" data-delay="200">
                Tohle je moje cesta, ne návod. Ta tvoje bude vypadat jinak &#8211; a je to tak v pořádku.
            </p>

            <!-- Tlacitko pod odstavcem, ne mezi fotkami. Mezi nimi
                 prekryvalo obe fotky a pusobilo jako chyba. -->
            <div class="hhn-center-action o_snippet_drop_in_only">
                <a href="/zpet-do-zivota" class="hhn-cta" data-anim="fade-in" data-delay="200">
                    Začni zde zdarma
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
                </a>
            </div>
        </div>
    </section>
</template>

