<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_hh_cta_form" name="HH Final CTA Form">
    <section class="hh-final-cta o_cc o_colored_level oe_img_bg o_bg_img_center" id="kontakt"
             data-snippet="s_hh_cta_form"
             data-name="HH Final CTA Form"
             style="background-image: url('/theme_honzahauzr/static/src/img/content/cta-sunset-river.jpg'); background-size: cover; background-position: center;">
        <div class="hh-final-cta__gradient"/>
        <div class="hh-final-cta__content">
            <div class="container">
                <div class="hh-final-cta__inner">
                    <h2 data-anim="fade-up">
                        První krok je nejdůležitější.<br/>
                        <span style="text-decoration: underline; text-decoration-color: rgba(255, 255, 255, 0.3);">Udělej ho teď.</span>
                    </h2>
                    <p class="hh-final-cta__sub" data-anim="fade-up" data-delay="150">
                        Vyplněním formuláře nic nezavazuješ. Ozvu se ti do 24 hodin.
                    </p>
                    <div data-anim="fade-up" data-delay="250">
                        <div class="hh-final-cta__urgency">Volná kapacita pro 5 nových klientů</div>
                    </div>
                    <form class="hh-form s_website_form" data-anim="fade-up" data-delay="350"
                          action="/website/form/" method="post" enctype="multipart/form-data"
                          data-model_name="crm.lead" data-success-mode="message">
                        <div class="s_website_form_rows">
                            <div class="s_website_form_field s_website_form_dnone">
                                <input type="hidden" class="s_website_form_input" name="name" value="Poptávka z honzahauzr.cz"/>
                            </div>
                            <div class="s_website_form_field mb-3 s_website_form_required" data-type="char">
                                <input class="hh-form__input s_website_form_input" type="text" name="contact_name" required="1" placeholder="Tvé jméno *"/>
                            </div>
                            <div class="s_website_form_field mb-3 s_website_form_model_required" data-type="email">
                                <input class="hh-form__input s_website_form_input" type="email" name="email_from" required="1" placeholder="Tvůj e-mail *"/>
                            </div>
                            <div class="s_website_form_field mb-3" data-type="tel">
                                <input class="hh-form__input s_website_form_input" type="tel" name="phone" placeholder="Telefon"/>
                            </div>
                            <div class="s_website_form_field mb-3 s_website_form_custom s_website_form_required" data-type="char">
                                <select class="hh-form__input s_website_form_input" name="interest" required="1">
                                    <option value="" disabled="disabled" selected="selected">Mám zájem o... *</option>
                                    <option value="Individuální koučink">Individuální koučink</option>
                                    <option value="Skupinový program">Skupinový program</option>
                                    <option value="Workshop nebo přednáška">Workshop nebo přednáška</option>
                                    <option value="Firemní spolupráce">Firemní spolupráce</option>
                                    <option value="Jen konzultace zdarma">Jen konzultace zdarma</option>
                                </select>
                            </div>
                            <div class="s_website_form_field mb-3" data-type="text">
                                <textarea class="hh-form__input s_website_form_input" name="description" placeholder="Co bys chtěl/a změnit? Napiš cokoliv..." rows="3"/>
                            </div>
                            <div class="s_website_form_submit mb-0">
                                <span id="s_website_form_result"/>
                                <a href="#" role="button" class="hh-btn hh-btn--primary hh-btn--large s_website_form_send">
                                    Odeslat nezávaznou přihlášku
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
