<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ===================================================================
     Sekce hlavní stránky Vlastní režie jako samostatné snippety.

     Stránka samotná je má vložené přímo v sobě, takže se dají
     přepisovat a přesouvat. Tyhle šablony slouží k tomu, aby šlo
     sekci znovu přidat, když ji někdo smaže nebo chce mít dvakrát.
     ================================================================== -->

<template id="s_vr_hero" name="Vlastní režie — úvod">
<section class="s_vr_hero hero">
                  <div class="wrap hero-grid">
                    <div class="hero-copy">
                      <div class="eyebrow">Praktická vzdělávací platforma pro skutečný život</div>
                      <h1 class="display">TVŮJ ŽIVOT.<br/><span>TVOJE PRAVIDLA.</span></h1>
                      <p class="lead">Tvůj život nemusí být průser, aby nebyl úplně tvůj. Vlastní režie je prostor pro muže, kteří nechtějí jen dál fungovat — chtějí pravdivě vidět, kde právě jsou, a udělat další krok, který je opravdu jejich.</p>
                      <div class="hero-actions">
                        <a class="btn btn-dark" href="/zpet-do-zivota">Začni 3denní výzvou <span class="arrow">→</span></a>
                        <a class="btn" href="#jak">Poznej Vlastní režii</a>
                      </div>
                      <div class="hero-note">Bez návodu na jediný správný život. Bez další dávky motivace. S konkrétní prací v realitě.</div>
                    </div>
                    <div class="hero-visual" aria-label="Honza Hauzr na cestě">
                      <div class="hero-photo"></div>
                      <div class="hero-stamp"><strong>Výchozí bod</strong>Z autopilota do vlastní režie.</div>
                    </div>
                  </div>
                </section>
</template>

<template id="s_vr_znacka" name="O značce">
<section class="s_vr_znacka section" id="o-znacce">
                  <div class="wrap">
                    <div class="problem-head">
                      <div><div class="eyebrow">Proč Vlastní režie</div></div>
                      <div><h2>Nejsi tu proto, abys celý život jen dobře zvládal cizí scénář.</h2><p class="lead muted">Vlastní režie neznamená mít všechno pod kontrolou. Znamená vědoměji rozhodovat o tom, co ovlivnit můžeš: o svých volbách, hranicích, vztazích, těle, práci, čase i směru.</p></div>
                    </div>
                    <div class="truth-lines">
                      <div class="truth-row"><span class="no">01</span><strong>Všechno funguje. Ale něco z toho už není tvoje.</strong><span>↗</span></div>
                      <div class="truth-row"><span class="no">02</span><strong>Víš, co změnit. Jen to znovu odkládáš.</strong><span>↗</span></div>
                      <div class="truth-row"><span class="no">03</span><strong>Rozumíš tomu. Ale ještě podle toho nežiješ.</strong><span>↗</span></div>
                    </div>
                    <div class="question">Vracíme pozornost k jediné otázce:<br/><strong>Co s tím udělám já?</strong></div>
                  </div>
                </section>
</template>

<template id="s_vr_jak" name="Jak to funguje">
<section class="s_vr_jak section method" id="jak">
                  <div class="wrap">
                    <div class="method-intro">
                      <div><div class="eyebrow">Jak pracujeme</div><h2>Z poznání musí vzniknout tah.</h2></div>
                      <p class="lead muted">Nechceme ti řídit život. Dáváme ti strukturu, nástroje a otázky, díky kterým se v něm začneš lépe orientovat a rozhodovat sám.</p>
                    </div>
                    <div class="method-track">
                      <div class="method-step"><b>01</b><strong>Realita</strong><p>Zastavíš se a pojmenuješ, kde skutečně jsi.</p></div>
                      <div class="method-step"><b>02</b><strong>Pochopení</strong><p>Uvidíš vzorce, které řídí tvoje automatické reakce.</p></div>
                      <div class="method-step"><b>03</b><strong>Rozhodnutí</strong><p>Oddělíš vlastní směr od převzatých očekávání.</p></div>
                      <div class="method-step"><b>04</b><strong>Akce</strong><p>Převedeš uvědomění do konkrétního chování.</p></div>
                      <div class="method-step"><b>05</b><strong>Reflexe</strong><p>Ověříš, co funguje v realitě — a upravíš další tah.</p></div>
                    </div>
                  </div>
                </section>
</template>

<template id="s_vr_vyzva" name="3denní výzva">
<section class="s_vr_vyzva section challenge" id="vyzva">
                  <div class="wrap challenge-grid">
                    <div>
                      <div class="eyebrow">Začni tady · bezplatná 3denní výzva</div>
                      <h2>Z autopilota zpět do života</h2>
                      <p class="lead">Za tři dny si nevyřešíš celý život. Zastavíš se, podíváš se pravdivě na jednu jeho důležitou část a uděláš první vědomý krok místo dalšího automatického pokračování.</p>
                      <div class="meta"><span class="chip">3 dny</span><span class="chip">3 videa</span><span class="chip">3 konkrétní kroky</span><span class="chip">zdarma</span></div>
                      <a class="btn btn-dark" href="/zpet-do-zivota">Vstoupit do výzvy zdarma <span class="arrow">→</span></a>
                    </div>
                    <div class="days">
                      <div class="day"><b>DEN 01</b><div><strong>Zrcadlo a pravda</strong><p>Uvidíš, kde dnes stojíš a co už nechceš dál ignorovat.</p></div></div>
                      <div class="day"><b>DEN 02</b><div><strong>Sebevědomí z důkazů</strong><p>Nastavíš si jeden konkrétní důkaz a minimum pro den, kdy nebude energie, čas ani nálada.</p></div></div>
                      <div class="day"><b>DEN 03</b><div><strong>Přeruš autopilota</strong><p>Pojmenuješ odkládané rozhodnutí, automatickou náhradu i cenu, kterou za ni dlouhodobě platíš.</p></div></div>
                    </div>
                  </div>
                </section>
</template>

<template id="s_vr_tvuj_tah" name="Tvůj tah">
<section class="s_vr_tvuj_tah flagship" id="tvuj-tah">
                  <div class="wrap">
                    <div class="flag-top">
                      <div><div class="eyebrow">První hlavní program Vlastní režie</div><div class="flag-title">TVŮJ TAH<small>40 dní ve vlastní režii</small></div></div>
                      <div><p class="promise">40 dní nestačí na nový život. Stačí ale na to, abys přestal bloudit.</p><p class="muted" style="color:#bfc2c3">Vedený proces s jasným začátkem a koncem. Přestaneš jen přemýšlet nad tím, co bys měl změnit, a začneš to převádět do konkrétních rozhodnutí a kroků.</p></div>
                    </div>
                    <div class="phases">
                      <div class="phase"><b>FÁZE 01</b><strong>Probuzení</strong><p>Poskládáš pravdivější výchozí mapu sebe a svého současného života.</p></div>
                      <div class="phase"><b>FÁZE 02</b><strong>Respekt k sobě</strong><p>Začneš budovat konkrétní důkazy, že se o svoje vlastní slovo můžeš opřít.</p></div>
                      <div class="phase"><b>FÁZE 03</b><strong>Vlastní pravidla</strong><p>Pojmenuješ hranice a pravidla, podle kterých chceš svůj život skutečně řídit.</p></div>
                      <div class="phase"><b>FÁZE 04</b><strong>Tvůj tah</strong><p>Zvolíš 90denní prioritu, uděláš první akci a svůj plán otestuješ v realitě.</p></div>
                    </div>
                    <div class="delivery">
                      <div class="delivery-copy"><span>11 hlavních videí</span><span>fyzický workbook · 125 stran</span><span>soukromé členské prostředí Vlastní režie</span><span>3 živá setkání</span><span>průběžná podpora</span></div>
                      <a class="btn btn-light" href="#">Poznat program Tvůj tah <span class="arrow">→</span></a>
                    </div>
                  </div>
                </section>
</template>

<template id="s_vr_pravidla" name="Vlastní pravidla">
    <section class="s_vr_pravidla section rules" id="vlastni-pravidla">
      <div class="wrap rules-grid">
        <div class="rules-copy">
          <div class="eyebrow">Hranice a respekt k sobě</div>
          <h2>Vlastní pravidla</h2>
          <p class="rules-claim">Říct NE. A stát si za tím.</p>
          <p class="lead muted">Říkáš ANO, i když chceš říct NE? Připravujeme praktický program, ve kterém si ujasníš vlastní potřeby a hranice, naučíš se je sdělit a stát si za nimi i ve chvíli, kdy druhý nesouhlasí.</p>
          <!-- Stitek, ne tlacitko: span bez odkazu, nic klikaciho. -->
          <span class="rules-stitek"><i></i>Připravujeme</span>
        </div>
        <ol class="rules-kroky">
          <li><b>01</b><strong>Poznat</strong></li>
          <li><b>02</b><strong>Definovat</strong></li>
          <li><b>03</b><strong>Komunikovat</strong></li>
          <li><b>04</b><strong>Ustát</strong></li>
        </ol>
      </div>
    </section>
</template>

<template id="s_vr_zakladatel" name="O zakladateli">
<section class="s_vr_zakladatel section founder">
                  <div class="wrap founder-grid">
                    <div class="founder-photo" aria-label="Honza Hauzr v horách"></div>
                    <div>
                      <div class="eyebrow">Zakladatel Vlastní režie</div>
                      <h2>Honza otevírá dveře. Vlastní režie je svět, do kterého vstoupíš.</h2>
                      <p class="lead">Dlouho jsem navenek fungoval. Měl jsem práci, výsledky i cestu, která dávala smysl. Jen jsem si postupně uvědomil, že velká část směru, kterým jdu, vlastně není úplně moje.</p>
                      <p class="muted">Vlastní režie nevznikla z pozice člověka, který má všechno vyřešené. Vznikla z přesvědčení, že pochopení má vést k rozhodnutí a rozhodnutí ke skutečnému kroku. Neřeknu ti, jak máš žít. Pomůžu ti ale podívat se na vlastní vzorce tak, aby další tah byl opravdu tvůj.</p>
                      <div class="signature">Honza Hauzr · mentor pro muže · zakladatel</div>
                      <a class="btn" href="#">Poznat Honzu a jeho příběh <span class="arrow">→</span></a>
                    </div>
                  </div>
                </section>
</template>

<template id="s_vr_newsletter" name="Newsletter">
<section class="s_vr_newsletter newsletter">
      <div class="wrap newsletter-row">
        <div><div class="eyebrow">Poznámky z vlastní režie</div><h3>Jednou za čas konkrétní myšlenka. Žádný motivační spam.</h3></div>
        <!-- Formular na odber je na webu jen jeden, na hlavni strance.
             Druhy by znamenal udrzovat tentyz text na dvou mistech.
             Adresa se bere ze stejneho parametru jako cil loga, takze
             se pri spusteni na ostro prepisuje na jednom miste. -->
        <a class="btn btn-dark" t-att-href="(env['ir.config_parameter'].sudo().get_param('theme_honzahauzr.odkaz_loga') or '/').rstrip('/') + '/#newsletter'">Chci odebírat <span class="arrow">→</span></a>
      </div>
    </section>
</template>

<template id="s_vr_zaver" name="Závěr">
<section class="s_vr_zaver closing">
                  <div class="wrap">
                    <div class="eyebrow">Tvůj další tah</div>
                    <h2>Nemusíš znát celý plán. Potřebuješ vědět, co uděláš dál.</h2>
                    <div class="hero-actions"><a class="btn btn-dark" href="/zpet-do-zivota">Začni bezplatnou 3denní výzvou <span class="arrow">→</span></a><a class="btn" href="#tvuj-tah">Prozkoumat Tvůj tah</a></div>
                  </div>
                </section>
</template>

</odoo>