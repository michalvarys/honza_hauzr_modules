<!-- ================================================================
     Sekce stránky Zpět do života (třídenní výzva).

     Obsah je shodný s tím, co je vepsaný přímo ve stránce. Dvojí
     zápis je záměr: stránka musí být složená z hotových sekcí,
     protože obsah schovaný za t-call by sice šel vidět, ale nešel
     by v editoru smazat ani přesunout. Tahle kopie slouží panelu
     s bloky, aby šla sekce přidat i tam, kde zrovna není.
     ================================================================ -->

<template id="s_hhv_hero" name="Výzva — hlavička">
<div class="hh-blok hhv" data-name="blok">
        <section data-name="Výzva — hlavička" class="hhv-hero o_cc o_colored_level" id="uvod">
                        <div class="container">
                            <div class="hhv-hero__grid">
                                <div class="hhv-hero__text">
                                    <span class="hhv-eyebrow" data-hhv-anim="up">Bezplatná 3denní online výzva pro muže</span>
                                    <h1 class="hhv-h1" data-hhv-anim="up" data-hhv-delay="80">
                                        Z autopilota<br/>zpět do života
                                    </h1>
                                    <p class="hhv-lead" data-hhv-anim="up" data-hhv-delay="160">
                                        Za 3 dny uvidíš, kde se ve vlastním životě zasekáváš — a uděláš
                                        první konkrétní krok zpět k sobě.
                                    </p>
                                    <p class="hhv-body" data-hhv-anim="up" data-hhv-delay="220">
                                        Možná tvůj život není katastrofa. Chodíš do práce. Plníš povinnosti.
                                        Zvenku může vypadat, že vlastně funguješ. Jen někde uvnitř víš,
                                        že některé důležité věci už dlouho odkládáš.
                                    </p>
                                    <div class="hhv-hero__action" data-hhv-anim="up" data-hhv-delay="280">
                                        <a href="#registrace" class="hhv-cta" data-hhv-misto="hero">Chci vstoupit do výzvy zdarma</a>
                                    </div>
                                    <p class="hhv-micro" data-hhv-anim="up" data-hhv-delay="340">
                                        <strong>3 dny &#8226; 3 videa &#8226; 3 konkrétní kroky</strong>
                                        Přijde ti vždy jeden e-mail denně.
                                    </p>
                                </div>
                                <!-- Skutecny obrazek, ne pozadi. Na pozadi se
                                     nepredava prohlizeci prednost pri nacitani
                                     a na uzkem displeji se spolehal na vysku,
                                     kterou mu dal ramecek.
    
                                     eager a fetchpriority="high" zamerne: je to
                                     hlavni obrazek uvodni obrazovky, ma se zacit
                                     nacitat hned, ne az na nej dojde rada. -->
                                <div class="hhv-hero__photo">
                                    <img src="/theme_honzahauzr/static/src/img/vyzva-hero.webp"
                                         alt="Honza Hauzr u motorky na polní cestě při západu slunce"
                                         loading="eager" fetchpriority="high" decoding="async"/>
                                </div>
                            </div>
                        </div>
                    </section>
</div>
</template>

<template id="s_hhv_zastaveni" name="Výzva — zastavení">
<div class="hh-blok hhv" data-name="blok">
        <section data-name="Výzva — zastavení" class="hhv-stop o_cc o_colored_level">
                        <div class="hhv-stop__pas">
                            <div class="container">
                                <div class="hhv-stop__inner">
                                    <p class="hhv-stop__intro" data-hhv-anim="up">
                                        Možná ses přestal rozhodovat — a začal spíš pokračovat.
                                    </p>
                                    <h2 class="hhv-h2 hhv-stop__claim" data-hhv-anim="up" data-hhv-delay="120">
                                        A pokud nic nezměníš, dalších pět let nemusí vypadat hůř.<br/>
                                        Můžou vypadat úplně stejně.
                                    </h2>
                                    <p class="hhv-stop__text" data-hhv-anim="up" data-hhv-delay="200">
                                        Možná máš rodinu, práci, závazky a spoustu důvodů nic
                                        neměnit. Jenže i život, který není katastrofa, může být
                                        životem, ve kterém se sám sobě postupně vzdaluješ.
                                    </p>
                                    <p class="hhv-stop__text" data-hhv-anim="up" data-hhv-delay="260">
