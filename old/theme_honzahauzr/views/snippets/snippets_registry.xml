<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="honzahauzr_snippets" name="Honza Hauzr Snippets" inherit_id="website.snippets">
    <xpath expr="//snippets[@id='snippet_structure']" position="after">
        <snippets id="hh_snippets" string="Honza Hauzr">
            <t t-snippet="theme_honzahauzr.s_hh_hero"
               t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hh_hero.svg"/>
            <t t-snippet="theme_honzahauzr.s_hh_vision_strip"
               t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hh_vision_strip.svg"/>
            <t t-snippet="theme_honzahauzr.s_hh_pain"
               t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hh_pain.svg"/>
            <t t-snippet="theme_honzahauzr.s_hh_transform"
               t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hh_transform.svg"/>
            <t t-snippet="theme_honzahauzr.s_hh_offer"
               t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hh_offer.svg"/>
            <t t-snippet="theme_honzahauzr.s_hh_process"
               t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hh_process.svg"/>
            <t t-snippet="theme_honzahauzr.s_hh_testimonials"
               t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hh_testimonials.svg"/>
            <t t-snippet="theme_honzahauzr.s_hh_cta_form"
               t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hh_cta_form.svg"/>
            <t t-snippet="theme_honzahauzr.s_hh_wip"
               t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hh_wip.svg"/>
        </snippets>
    </xpath>
</template>

</odoo>
