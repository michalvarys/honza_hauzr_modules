           t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hhn_galerie.png"/>
        <t t-snippet="theme_honzahauzr.s_hhn_jak" string="Jak pracuji" group="honzahauzr"
           t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hhn_jak.png"/>
        <t t-snippet="theme_honzahauzr.s_hhn_vyzva" string="Bezplatná třídenní výzva" group="honzahauzr"
           t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hhn_vyzva.png"/>
        <t t-snippet="theme_honzahauzr.s_hhn_news" string="Newsletter" group="honzahauzr"
           t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hhn_news.png"/>
        <t t-snippet="theme_honzahauzr.s_hhn_paticka" string="Patička" group="honzahauzr"
           t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hhn_paticka.png"/>

        <!-- Sekce ze starsiho designu (/stary) -->
        <t t-snippet="theme_honzahauzr.s_hh_hero" string="Úvodní obrazovka" group="honzahauzr"
           t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hh_hero.png"/>
        <t t-snippet="theme_honzahauzr.s_hh_pain" string="Problémy" group="honzahauzr"
