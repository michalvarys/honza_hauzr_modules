    <!-- Snippety samotne -->
    <xpath expr="//snippets[@id='snippet_structure']" position="inside">

        <!-- Sekce uvodni stranky (novy design) -->
        <t t-snippet="theme_honzahauzr.s_hhn_hero" string="Úvodní obrazovka" group="honzahauzr"
           t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hhn_hero.png"/>
        <t t-snippet="theme_honzahauzr.s_hhn_poznani" string="V čem se poznáš" group="honzahauzr"
           t-thumbnail="/theme_honzahauzr/static/src/img/snippets/s_hhn_poznani.png"/>
