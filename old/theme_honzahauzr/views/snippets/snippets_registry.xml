<!--
    Pravidlo pro jednotlive polozky.

    Sekce jsou <section>, na ty staci vestavene pravidlo Odoo
    (so_snippet_addition) a vlastni se pridavat nesmi - kolidovalo by
    s nim a editor by snippet odmitl pustit kamkoliv.

    Polozky ale zadny <section> nejsou, takze potrebuji vlastni zaznam.
    Rika, ze se daji chytit a pustit vedle sveho druhu - dalsi bod mezi
    body, dalsi fotka mezi fotky.

    POZOR: pravidla drop zon nejsou v website.snippets, ale ve zvlastni
    sablone website.snippet_options. Pri pokusu vlozit to do snippets
    spadl cely panel s bloky - vcetne vlastnich snippetu Odoo - na
    hlasku "Prvek <xpath ...> nelze najit v nadrazenem pohledu".
-->
<!-- .hhd-den jsou dny na strance tridenni vyzvy. Patri sem, aby
     se do nich dal pretahnout box na video - jinak by byl v panelu
     sedy, protoze na te strance nic jineho z tohohle seznamu neni.

     drop-near dava misto mezi dny, drop-in primo dovnitr dne pod
     nadpis. Bez toho druheho by video slo polozit jen mezi bloky. -->
<template id="honzahauzr_snippet_options" name="Honza Hauzr - volby snippetů"
          inherit_id="website.snippet_options">
    <xpath expr="//div[@id='so_content_addition']" position="after">
        <div id="hhn_polozky"
             data-selector=".hhn-point, .hhn-pillar, .hhn-step, .hhn-card, .hhn-gallery figure, .hhn-video, .hhv-soubor, .hhn-center-action, .hhd-den"
             data-drop-near=".hhn-point, .hhn-pillar, .hhn-step, .hhn-card, .hhn-gallery figure, .hhn-video, .hhv-soubor, .hhn-center-action, .hhd-den"
             data-drop-in=".hhd-den"/>
    </xpath>
</template>


<!-- Policko na adresu videa pro mobil.

     Blok je na strance jen jeden. Na sirokem okne hraje video z
     bezneho video bloku Odoo (dvojklik, dialog Vyberte media), na
     uzkem to, co je tady. Bez toho by na strance musely byt dva
     bloky a na ten schovany by v editoru neslo kliknout.

     Odoo pise hodnotu do data-hhn-video-mobil, odkud si ji bere
     hh-video.js. Zadny vlastni skript k tomu netreba. -->
<template id="honzahauzr_volba_videa" name="Honza Hauzr - video pro mobil"
          inherit_id="website.snippet_options">
    <xpath expr="//div[@id='so_content_addition']" position="after">
        <div data-selector=".hhn-video, .hhd-video">
            <we-input string="Video pro mobil"
                      data-select-data-attribute=""
                      data-attribute-name="hhnVideoMobil"
                      data-no-preview="true"
                      placeholder="odkaz na video na výšku"/>
        </div>
    </xpath>
</template>

<!-- Volby bloku "Video ze souboru".

     Tlacitko otevre bezny dialog "Vyberte média" na zalozce Dokumenty,
     kde se soubor nahraje. Adresu vybraneho souboru zapise do
     data-hhv-soubor - obsluha je v static/src/js/hh-video-soubor-volby.js.

     Policko pod nim ukazuje, co je vybrane, a da se do nej adresa
     vlozit i rucne, kdyby soubor uz na webu byl.

     Nahled se meni dvojklikem primo na obrazek, na to neni potreba
     zadna volba navic.

     Popisek s limitem tam neni pro ozdobu. Kdyz je soubor nad strop
     (web.max_file_upload_size, nastavuje honzahauzr_crm na 512 MB),
     Odoo neudela vubec nic - zadna hlaska, dialog zustane otevreny.
     Bez tehle vety clovek jen tezko uhodne, proc se nic nedeje. -->
<template id="honzahauzr_volba_video_soubor" name="Honza Hauzr - video ze souboru"
          inherit_id="website.snippet_options">
    <xpath expr="//div[@id='so_content_addition']" position="after">
        <div data-js="hhVideoSoubor" data-selector=".hhv-soubor">
            <we-row string="Vlastní video">
                <!-- Bootstrapovske text-muted je na tmavem panelu
                     editoru skoro necitelne, proto barva natvrdo. -->
                <div style="color: #b4b8bf; font-size: 11px; line-height: 1.35; padding: 2px 0;">
                    Nejvýš 512 MB. Delší video dej na YouTube a vlož
                    blokem „Video“ — streamuje se po kouscích.
                </div>
            </we-row>
            <we-button data-vybrat-soubor="1" data-no-preview="true">
                Nahrát video
            </we-button>
            <we-input string="Adresa souboru"
                      data-select-data-attribute=""
                      data-attribute-name="hhvSoubor"
                      data-no-preview="true"
                      placeholder="/web/content/..."/>
            <we-button data-vybrat-soubor-mobil="1" data-no-preview="true">
                Nahrát video pro mobil
            </we-button>
            <we-input string="Soubor pro mobil"
                      data-select-data-attribute=""
                      data-attribute-name="hhvSouborMobil"
                      data-no-preview="true"
                      placeholder="/web/content/..."/>
        </div>
    </xpath>
</template>
</odoo>
