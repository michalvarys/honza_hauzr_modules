<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ================================================================ -->
<!-- LANDING PAGE - all content inlined for independent editing       -->
<!-- ================================================================ -->
<template id="hh_page_landing" name="Honza Hauzr Landing">
    <t t-call="website.layout">
        <!-- Hlavicka ZAMERNE nezustava vypnuta. Logo i polozky menu jsou
             nastavene v Odoo (Website > Konfigurace), takze si je Honza
             spravuje sam bez sahani do kodu. Drive tu bylo no_header,
             coz tu nastavenou hlavicku i s logem zahodilo. -->
        <t t-set="no_footer" t-value="True"/>
        <t t-set="additional_title">Honza Hauzr | Začni žít naplno</t>
        <t t-set="meta_description">Pomáhám lidem, kteří fungují na autopilotu, vrátit si směr, hranice a respekt k sobě. Domluv si nezávazný úvodní hovor.</t>

        <div id="wrap" class="oe_structure oe_empty hh-landing">

            <!-- ============================================================
                 Poradi bloku podle zadani klienta:
                 hero - v cem se poznas - muj pribeh - jak pracuji -
                 hlavni vyzva - newsletter - paticka.

                 Vsechna hlavni tlacitka maji stejny popisek "Zacni zde zdarma".
                 Cilova adresa landing page vyzvy zatim neexistuje, proto vsude
                 miri na kotvu #zacni. Az adresa bude, preklopi se najednou -
                 staci nahradit href="#zacni".

                 Zamerne tu NENI: rezervace hovoru, kalendar, popis programu
                 Tvuj tah, PDF zdarma, reference ani cisla.
                 ============================================================ -->

            <!-- 2. UVODNI OBRAZOVKA -->
            <!-- Fotka je na pozadi sekce pres oe_img_bg, aby sla v Odoo editoru
                 vymenit pres volbu Pozadi. -->
            <section class="hh-hero o_cc o_colored_level oe_img_bg o_bg_img_center" id="hero"
                     style="background-image: url(/theme_honzahauzr/static/src/img/hero-balon.webp); background-size: cover; background-position: center;">
                <div class="hh-hero__bg"/>
                <div class="container">
                    <div class="hh-hero__content">
                        <h1 data-anim="fade-up">
                            Přestaň jen fungovat.<br/>Vezmi svůj život zpátky do <em>vlastní režie</em>
                        </h1>
                        <p class="hh-hero__sub" data-anim="fade-up" data-delay="150">
                            Pomáhám mužům, kteří navenek fungují, ale uvnitř vědí, že takhle už
                            nechtějí pokračovat, pochopit, co je drží na místě, nastavit vlastní
                            pravidla a udělat konkrétní další krok.
                        </p>
                        <div class="hh-hero__ctas" data-anim="fade-up" data-delay="300">
                            <a href="#zacni" class="hh-btn hh-btn--primary hh-btn--large">Začni zde zdarma</a>
                        </div>
                        <p class="hh-hero__note" data-anim="fade-up" data-delay="400">
                            Bezplatná třídenní výzva Z autopilota zpátky do života.
                        </p>
                    </div>
                </div>
            </section>

            <!-- 3. V CEM SE MUZE NAVSTEVNIK POZNAT -->
            <section class="hh-pain o_cc o_colored_level" id="problemy">
                <div class="container">
                    <div class="hh-pain__header">
                        <h2 data-anim="fade-up">
                            Možná nepotřebuješ začít znovu.<br/>Potřebuješ přestat jet na <span class="hh-text-gradient-warm">autopilota</span>
                        </h2>
                    </div>
                    <div class="hh-pain__grid">
                        <div class="hh-pain__card" data-anim="fade-up" data-delay="80">
                            <p>Všechno nějak funguje, ale na nic se pořádně netěšíš.</p>
                        </div>
                        <div class="hh-pain__card" data-anim="fade-up" data-delay="160">
                            <p>Víš, co bys měl udělat, ale svoje rozhodnutí opakovaně odkládáš.</p>
                        </div>
                        <div class="hh-pain__card" data-anim="fade-up" data-delay="240">
                            <p>Ve vztazích ustupuješ, ztrácíš sebe nebo nedokážeš nastavit hranici.</p>
                        </div>
                        <div class="hh-pain__card" data-anim="fade-up" data-delay="320">
                            <p>Navenek máš výsledky, ale chybí ti směr a nevíš, co vlastně buduješ.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 4. MUJ PRIBEH - DRIV A DNES -->
            <section class="hh-story o_cc o_colored_level" id="o-mne">
                <div class="container">
                    <div class="hh-story__header">
                        <h2 data-anim="fade-up">
                            Znám život na autopilota<br/>i <span class="hh-text-gradient-warm">cenu změny</span>
                        </h2>
                        <p data-anim="fade-up" data-delay="120">
                            Nejde o to, že bych žil dokonale. Jde o to, že jsem si začal říkat pravdu,
                            držet vlastní slovo, nastavovat hranice a dělat konkrétní kroky.
                        </p>
                    </div>
                    <div class="hh-story__pair">
                        <div class="hh-story__card" data-anim="fade-right" data-delay="150">
                            <div class="hh-story__photo">
                                <span class="hh-story__tag hh-story__tag--driv">Dřív</span>
                                <img src="/theme_honzahauzr/static/src/img/pribeh-driv.webp" alt="Honza Hauzr dřív"/>
                            </div>
                            <div class="hh-story__caption">
                                <h3>Utíkal jsem před sebou</h3>
                                <p>Pivo, cigareta, další víkend pryč. Vypadalo to jako pohoda. Byl to únik.</p>
                            </div>
                        </div>
                        <div class="hh-story__card" data-anim="fade-left" data-delay="250">
                            <div class="hh-story__photo">
                                <span class="hh-story__tag hh-story__tag--dnes">Dnes</span>
                                <img src="/theme_honzahauzr/static/src/img/pribeh-dnes.webp" alt="Honza Hauzr dnes"/>
                            </div>
                            <div class="hh-story__caption">
                                <h3>Vím, kam jdu</h3>
                                <p>Ne proto, že mám vyřešeno. Proto, že jsem přestal čekat, až to přijde samo.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 5. JAK PRACUJI -->
            <section class="hh-approach o_cc o_colored_level" id="jak-pracuji">
                <div class="container">
                    <div class="hh-approach__header">
                        <h2 data-anim="fade-up">
                            Tvoje cesta začíná u toho,<br/>co <span class="hh-text-gradient-warm">můžeš ovlivnit</span>
                        </h2>
                    </div>
                    <div class="hh-approach__grid">
                        <div class="hh-approach__item" data-anim="fade-up" data-delay="80">
                            <h3>Pravda místo výmluv</h3>
                        </div>
                        <div class="hh-approach__item" data-anim="fade-up" data-delay="160">
                            <h3>Odpovědnost místo čekání</h3>
                        </div>
                        <div class="hh-approach__item" data-anim="fade-up" data-delay="240">
                            <h3>Konkrétní kroky místo další teorie</h3>
                        </div>
                        <div class="hh-approach__item" data-anim="fade-up" data-delay="320">
                            <h3>Vlastní pravidla místo života podle očekávání okolí</h3>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 7. NEWSLETTER -->
            <!-- Zamerne mensi a klidnejsi nez vyzva - je to vedlejsi moznost,
                 ne druha hlavni nabidka. Zadne PDF, zadne vyskakovaci okno.
                 Napojeni se doresi pozdeji, zatim jde o vizualni podobu. -->
            <section class="hh-news o_cc o_colored_level" id="newsletter">
                <div class="container">
                    <div class="hh-news__box" data-anim="fade-up">
                        <div class="hh-news__text">
                            <h3>Chceš zůstat v kontaktu?</h3>
                            <p>
                                Jednou za čas ti pošlu konkrétní myšlenku, otázku nebo tip, který ti
                                pomůže vystoupit z autopilota a žít víc podle sebe.
                            </p>
                        </div>
                        <div class="hh-news__form">
                            <input type="email" class="hh-news__input" placeholder="Tvůj e-mail" aria-label="E-mail"/>
                            <button type="button" class="hh-btn hh-btn--ghost">Chci odebírat</button>
                        </div>
                    </div>
                </div>
            </section>

            <section class="hh-footer o_cc o_colored_level">
                <div class="container">
                    <div class="hh-footer__grid">
                        <div>
                            <div class="hh-footer__brand">Honza Hauzr</div>
                            <p>Osobní rozvoj, koučink a mentoring.<br/>Pomáhám lidem vrátit si směr a respekt k sobě.</p>
                        </div>
                        <div class="hh-footer__col">
                            <h4>Kontakt</h4>
                            <ul>
                                <li><a href="mailto:honzahauzr@gmail.com">honzahauzr@gmail.com</a></li>
                            </ul>
                        </div>
                        <div class="hh-footer__col">
                            <h4>Sledovat</h4>
                            <div class="hh-social">
                                <a href="https://www.instagram.com/honzahauzr.cz/" target="_blank" rel="noopener" class="hh-social__btn hh-social__btn--ig" aria-label="Instagram" title="Instagram">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.8" cy="6.2" r="1.2" fill="currentColor" stroke="none"/></svg>
                                </a>
                                <a href="https://www.facebook.com/honzahauzr.cz" target="_blank" rel="noopener" class="hh-social__btn hh-social__btn--fb" aria-label="Facebook" title="Facebook">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M14.5 8.5V6.9c0-.8.2-1.2 1.4-1.2h1.6V2.8C17.1 2.7 16.2 2.6 15.2 2.6c-2.4 0-4.1 1.5-4.1 4.2v1.7H8.4v3.1h2.7v8.8h3.4v-8.8h2.6l.4-3.1z"/></svg>
                                </a>
                                <a href="https://www.youtube.com/@HonzaHauzr_cz" target="_blank" rel="noopener" class="hh-social__btn hh-social__btn--yt" aria-label="YouTube" title="YouTube">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22.5 7.2a2.7 2.7 0 0 0-1.9-1.9C18.9 4.8 12 4.8 12 4.8s-6.9 0-8.6.5A2.7 2.7 0 0 0 1.5 7.2C1 8.9 1 12 1 12s0 3.1.5 4.8a2.7 2.7 0 0 0 1.9 1.9c1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5a2.7 2.7 0 0 0 1.9-1.9c.5-1.7.5-4.8.5-4.8s0-3.1-.5-4.8M9.8 15.3V8.7l5.7 3.3z"/></svg>
                                </a>
                                <a href="https://www.tiktok.com/@honzahauzr.cz" target="_blank" rel="noopener" class="hh-social__btn hh-social__btn--tt" aria-label="TikTok" title="TikTok">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 2h-3.1v13.1a2.3 2.3 0 1 1-2.3-2.3c.2 0 .4 0 .6.1V9.7a5.6 5.6 0 0 0-.6 0 5.5 5.5 0 1 0 5.5 5.5V8.6a6.5 6.5 0 0 0 4 1.3V6.8a3.6 3.6 0 0 1-2.8-1.4A3.6 3.6 0 0 1 16.6 2"/></svg>
                                </a>
                            </div>
                        </div>
                    </div>
                    <!-- Pravni odkazy (Ochrana osobnich udaju, Obchodni podminky) tu zatim
                         nejsou - ty stranky neexistuji. Doplnit az budou realne URL. -->
                    <div class="hh-footer__bottom">
                        <p>&#169; 2026 Honza Hauzr. Všechna práva vyhrazena.</p>
                    </div>
                </div>
            </section>

        </div>
    </t>
</template>

<record id="hh_page_landing_page" model="theme.website.page">
    <field name="url">/</field>
    <field name="view_id" ref="hh_page_landing"/>
    <field name="is_published" eval="True"/>
</record>

