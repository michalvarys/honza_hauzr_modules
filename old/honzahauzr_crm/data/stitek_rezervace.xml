<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Přesun potvrzení rezervace do řady u sloupce Rezervace.

    Dřív mělo vlastní řadu bez sloupce. Honza chce mít všechno
    ovladatelné z nástěnky, takže zpráva patří do řady u sloupce
    Rezervace jako každá jiná.

    Mimo blok s noupdate schválně: tam se funkce při upgradu
    přeskakují. Tahle se pustí pokaždé a podruhé už nic nezmění.
-->
<data>
    <function model="hh.mail.sablona" name="_hh_zrusit_stitek_potvrzeni"/>
    <!--
        Zpráva s odkazem na hovor nesmí odejít řadou - odchází
        tlačítkem z karty, až Honza odkaz vloží. V databázi, kde
        vznikla dřív než ten příznak, by zůstala jako běžná zpráva
        řady a chodila by s prázdným tlačítkem.
    -->
    <function model="crm.lead" name="_hh_oznacit_meet_jako_rucni"/>
    <!--
        Uklid po kartach, ktere nekdo smazal driv, nez se to zacalo
        hlidat. Zustal po nich obsazeny termin bez karty: na nastence
        neni, ale kalendar ho drzi zabrany.
    -->
    <function model="crm.lead" name="_hh_uvolnit_osirele_terminy"/>
</data>

</odoo>
