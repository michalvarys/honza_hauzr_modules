<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Povoleni poli hh_zdroj a hh_web pro webove formulare.

    Odoo vsechna pole modelu ve vychozim stavu zahazuje a pusti do
    formulare jen ta, ktera si modul vysloveni vyzada. Bez tohohle
    zaznamu se skryte pole hh_zdroj z formulare tise ztratilo a
    prilezitost se zaradila jen podle toho, jestli se v jejim nazvu
    nahodou naslo slovo "vyzva" nebo "newsletter".

    Fungovalo to, ale drzelo to na tenkem vlakne: stacilo v editoru
    prejmenovat formular a lidi zacali padat do prvniho sloupce bez
    stitku. Zalozni rozpoznani podle nazvu v crm_lead.py zustava, uz
    ale jen jako pojistka pro starsi formulare.

    hh_sekce nese nazev sekce, ze ktere clovek prisel. Kdyz pro
    ni jeste neni sloupec na nastence, zalozi se i se stitky sam -
    viz crm_lead_sekce.py. Diky tomu staci na webu pridat formular
    a v administraci uz se nemusi nic chystat dopredu.

    hh_web rika, ze ktereho z obou webu clovek prisel. Odber
    novinek vede z obou do jedne schranky, takze bez nej by se
    odberatele nedali rozlisit.
-->
<function model="ir.model.fields" name="formbuilder_whitelist">
    <value>crm.lead</value>
    <value eval="['hh_zdroj', 'hh_web', 'hh_sekce']"/>
</function>

</odoo>
