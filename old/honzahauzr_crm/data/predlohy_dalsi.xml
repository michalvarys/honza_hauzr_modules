<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- =================================================================
     DALŠÍ PŘEDLOHY DO KNIHOVNY

     Chci odebírat — uvítací zpráva s tlačítkem do třídenní výzvy.
     Rezervace     — potvrzení hovoru s datem a časem, které si
                     předloha bere z karty ({{ object.hh_termin_kdy }}).

     Obě mají odstup nula, takže odejdou ve chvíli, kdy karta do
     sloupce vstoupí.

     Potvrzení rezervace zabudované v kódu se v takovém případě
     přeskočí, aby zpráva nepřišla dvakrát — zůstává ale jako
     pojistka, kdyby předlohu někdo smazal nebo vypnul.

     Skládá je nastroje/predlohy-dalsi.js; tenhle soubor se needituje
     ručně, přegeneruje se.

     noupdate="1": při prvním nasazení se založí, dál si je Honza
     upravuje v editoru a upgrade mu to nepřepíše.
     ================================================================= -->

<data noupdate="1">

    <record id="hh_stitek_potvrzeni_rezervace" model="hh.mail.stitek">
        <field name="name">Potvrzení rezervace</field>
        <field name="color">4</field>
    </record>

    <record id="hh_predloha_odber" model="hh.mail.sablona">
        <field name="name">Uvítání a pozvánka do výzvy</field>
        <field name="stitek_id" search="[('name', '=ilike', 'Chci odebírat')]"/>
        <field name="po_dnech">0</field>
        <field name="predmet">Díky za přihlášení — a jedna věc na začátek</field>
        <field name="preheader">Tři dny, tři videa, tři konkrétní kroky. Zdarma.</field>
        <!-- body_arch je podoba pro editor (bloky), body_html to,
             co odejde do pošty (tabulky). Viz nastroje/mail-bloky.js. -->
        <field name="body_arch"><![CDATA[<div class="o_layout oe_unremovable oe_unmovable bg-200 oe_styling_vr o_mass_mailing_no_theme" style="background-color:#f4efe6;" data-name="Mailing">
<style id="design-element">
.o_mail_wrapper { font-family: Helvetica, Arial, sans-serif; color: #5d554b; }
.o_mail_wrapper p { font-size: 16px; line-height: 1.65; margin: 0 0 18px 0; }
.o_mail_wrapper h1 { font-size: 28px; line-height: 1.25; font-weight: bold; color: #23211d; margin: 0 0 24px 0; }
.o_mail_wrapper .hh-eyebrow { font-size: 12px; letter-spacing: 1.6px; text-transform: uppercase; color: #a89681; margin: 0 0 14px 0; }
.o_mail_wrapper .hh-tmave { color: #23211d; }
.o_mail_wrapper .hh-drobne { font-size: 12px; line-height: 1.6; color: #8c8276; margin: 0; }
.o_mail_wrapper .hh-otazka { border-left: 3px solid #23211d; padding: 2px 0 2px 18px; font-size: 18px; line-height: 1.5; font-weight: bold; color: #23211d; margin: 0; }
.o_mail_wrapper .hh-ramecek { background-color: #f4efe6; border: 1px solid #e2dacb; padding: 20px 22px 4px 22px; }
.o_mail_wrapper .hh-ramecek p { color: #23211d; }
.o_mail_wrapper .hh-linka-nad { border-top: 1px solid #e2dacb; }
.o_mail_wrapper .hh-linka-pod { border-bottom: 1px solid #e2dacb; }
.o_mail_wrapper a.btn.btn-primary { background-color: #23211d; border-color: #23211d; color: #ffffff; font-size: 14px; letter-spacing: 1.2px; text-transform: uppercase; font-weight: bold; padding: 16px 34px; border-radius: 0; }
</style>
  <div class="container o_mail_wrapper o_mail_regular oe_unremovable">
    <div class="row">
      <div class="col o_mail_no_options o_mail_wrapper_td bg-white oe_structure o_editable">
        <div class="s_header_logo o_mail_block_header_logo o_mail_snippet_general hh-linka-pod pt24 pb16">
          <div class="container">
            <div class="row">
              <div class="col-8">
                <img src="/theme_honzahauzr/static/src/img/vr/vr-logo-email.png" alt="Vlastní režie" width="190" style="width:190px;height:auto;" class="img-fluid"/>
              </div>
              <div class="col-4" style="text-align:right;">
                <p class="hh-eyebrow" style="margin:10px 0 0 0;">Honza Hauzr</p>
              </div>
            </div>
          </div>
        </div>
        <div class="s_text_block o_mail_snippet_general pt16 pb16" style="padding-left:15px;padding-right:15px;">
          <div class="container s_allow_columns">
            <p class="hh-eyebrow">Vlastní režie</p>
            <h1>Díky, že čteš.</h1>
            <p class="hh-tmave">{{ object.hh_osloveni }}</p>
            <p>budu ti sem posílat to, co sám považuju za užitečné &#8212; žádné novinky ze světa a žádné rozesílky každý týden.</p>
            <p>Než přijde první, mám pro tebe jednu věc, která ti dá víc než čtení: <strong>bezplatnou třídenní výzvu</strong>. Tři dny, tři krátká videa a u každého jedna konkrétní věc, kterou si odneseš do běžného dne.</p>
            <p>Stačí na to dvacet minut denně. Klidně dneska večer.</p>
          </div>
        </div>
        <div class="s_call_to_action o_mail_snippet_general pt8 pb24" style="text-align:center;">
          <div class="container">
            <a href="/zpet-do-zivota" role="button" class="btn btn-primary">Vstoupit do výzvy zdarma</a>
          </div>
        </div>
        <div class="s_text_block o_mail_snippet_general pt16 pb16" style="padding-left:15px;padding-right:15px;text-align:center;">
          <div class="container s_allow_columns">
            <p class="hh-drobne">Je zdarma a nic tím nekupuješ.</p>
          </div>
        </div>
        <div class="s_text_block o_mail_snippet_general hh-linka-nad pt24 pb24" style="padding-left:15px;padding-right:15px;">
          <div class="container s_allow_columns">
            <p class="hh-tmave"><strong>Honza</strong></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>]]></field>
