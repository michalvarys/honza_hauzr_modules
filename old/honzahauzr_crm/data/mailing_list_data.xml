<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

<!--
    Seznamy adres v Email Marketingu, jeden na kazdy formular.

    Kdo se prihlasi, padne krome nastenky i sem - odtud se pak posila
    hromadna zprava, aniz by se museli adresy vypisovat rucne nebo
    exportovat z CRM.

    noupdate="1" je tu zamerne: az si je Honza prejmenuje nebo prida
    popis, upgrade modulu mu to neprepise zpatky.

    Nazvy sedi na stitky u prilezitosti, at se da jedno s druhym
    snadno parovat.
-->

<record id="seznam_newsletter" model="mailing.list">
    <field name="name">Newsletter</field>
    <field name="is_public" eval="True"/>
</record>

<record id="seznam_vyzva" model="mailing.list">
    <field name="name">3denní výzva</field>
    <field name="is_public" eval="True"/>
</record>

<record id="seznam_hovor" model="mailing.list">
    <field name="name">Úvodní hovor</field>
    <field name="is_public" eval="False"/>
</record>

<record id="seznam_rezervace" model="mailing.list">
    <field name="name">Rezervace hovoru</field>
    <field name="is_public" eval="False"/>
</record>

<record id="seznam_pdf" model="mailing.list">
    <field name="name">Stažení PDF</field>
    <field name="is_public" eval="False"/>
</record>

<record id="seznam_poptavka" model="mailing.list">
    <field name="name">Poptávka z webu</field>
    <field name="is_public" eval="False"/>
</record>

</data>
</odoo>
