<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- =================================================================
     VIDEA NA WEBU

     Jeden řádek na jedno video na jedné stránce: kolikrát ho někdo
     pustil, kolik procent z něj lidé v průměru viděli a kolik jich
     došlo na konec.

     Není to záznam za návštěvníka - na stránkách mimo výzvu nikdo
     přihlášený není. Kdo konkrétně na co koukal, je u něj na kartě
     a ve výkazu "Zhlédnutí videí".
     ================================================================= -->

<record id="view_hh_video_list" model="ir.ui.view">
    <field name="name">hh.video.list</field>
    <field name="model">hh.video</field>
    <field name="arch" type="xml">
        <list string="Videa na webu" create="false" default_order="spusteni desc">
            <field name="nazev" string="Video"/>
            <field name="stranka" string="Na stránce"/>
            <field name="spusteni" string="Spuštění" sum="Celkem"/>
            <field name="prumer" string="Průměrně zhlédnuto" widget="progressbar"/>
            <field name="dokoukani" string="Dokoukání" sum="Celkem"/>
            <field name="podil_dokoukani" string="Dokoukalo" widget="progressbar"/>
            <field name="delka" string="Délka (s)" optional="hide"/>
            <field name="naposledy" string="Naposledy" optional="show"/>
            <field name="poprve" string="Poprvé" optional="hide"/>
            <field name="video" string="Označení" optional="hide"/>
        </list>
    </field>
</record>

<record id="view_hh_video_graph" model="ir.ui.view">
    <field name="name">hh.video.graph</field>
    <field name="model">hh.video</field>
    <field name="arch" type="xml">
        <!-- Pruhy, ne koláč: tohle je žebříček "co se nejvíc pouští",
             ne rozdělení jednoho celku na podíly. -->
        <graph string="Videa na webu" type="bar" sample="1">
            <field name="nazev"/>
            <field name="spusteni" type="measure"/>
        </graph>
    </field>
</record>

<record id="view_hh_video_search" model="ir.ui.view">
    <field name="name">hh.video.search</field>
    <field name="model">hh.video</field>
    <field name="arch" type="xml">
        <search string="Videa na webu">
            <field name="nazev" string="Video"/>
            <field name="stranka" string="Stránka"/>
            <filter name="hh_nikdo" string="Nikdo nedokoukal"
                    domain="[('dokoukani', '=', 0)]"
                    help="Video lidé pouštějí, ale nikdo ho nedojede do konce."/>
            <group expand="0" string="Seskupit podle">
                <filter name="hh_podle_stranky" string="Stránka"
                        context="{'group_by': 'stranka'}"/>
                <filter name="hh_podle_videa" string="Video"
                        context="{'group_by': 'nazev'}"/>
            </group>
        </search>
    </field>
</record>

<record id="action_hh_video" model="ir.actions.act_window">
    <field name="name">Videa na webu</field>
    <field name="res_model">hh.video</field>
    <field name="view_mode">list,graph</field>
    <field name="search_view_id" ref="view_hh_video_search"/>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Zatím nikdo nic nepustil.</p>
        <p>
            Jakmile někdo na webu spustí video &#8212; kdekoliv, nejen
            ve výzvě &#8212; objeví se tu řádek s tím, kolikrát se
            pouštělo a kolik z něj lidé v průměru viděli.
        </p>
    </field>
</record>

</odoo>
