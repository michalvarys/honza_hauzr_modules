<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Adresa pro upozorneni do nastaveni CRM, aby se dala kdykoliv prepsat
    bez zasahu do kodu.

    Kotva miri na <app name="crm">, ne na konkretni blok. Bloky v tom
    pohledu vetsinou zadne id nemaji a jejich title se preklada - prvni
    pokus na //block[@id='crm_setting_container'] shodil cely upgrade
    hlaskou, ze prvek nelze najit v nadrazenem pohledu.
-->
<record id="res_config_settings_form_hh" model="ir.ui.view">
    <field name="name">res.config.settings.form.honzahauzr</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//app[@name='crm']" position="inside">
            <block title="Zprávy z webu" name="hh_web_messages">
                <setting string="Upozornění posílat na"
                         help="Na zadanou adresu přijde e-mail pokaždé, když někdo odešle formulář na webu. Zpráva se zároveň uloží mezi příležitosti. Prázdné pole = neposílá se nic.">
                    <field name="hh_notify_email" placeholder="honzahauzr@gmail.com"/>
                </setting>
            </block>

            <!--
                Rada e-mailu po dokoncene vyzve. Oboji se tyka jen rad
                oznacenych jako prodejni - provozni zpravy jedou dal
                bez ohledu na to.
            -->
            <block title="E-maily po výzvě" name="hh_po_vyzve">
                <setting string="Tlačítka vedou na"
                         help="Jedna adresa pro všechna tlačítka v řadě po výzvě. Prázdné pole = /rezervace na webu výzvy. Měřicí parametry si každá zpráva doplní sama.">
                    <field name="hh_odkaz_rezervace"
                           placeholder="https://vlastni-rezie.cz/rezervace"/>
                </setting>
                <setting string="Rezervace jsou otevřené"
                         help="Když zrovna neotevíráš běh, vypni. Prodejní e-maily se pozastaví, ať nikomu nechodí pozvánka na zavřený kalendář. Po zapnutí se pokračuje prvním neodeslaným; zameškané se nedoposílají.">
                    <field name="hh_rezervace_otevrene" widget="boolean_toggle"/>
                </setting>
            </block>

            <!--
                Rozvrh, podle ktereho se terminy vyrabeji samy. Drive se
                kazda hodina musela naklikat rucne - pri deseti hodinach
                denne to bylo neunosne.
            -->
            <block title="Termíny na hovor" name="hh_rezervace">
                <setting string="Kdy bereš hovory"
                         help="Den se podle těchhle hodin rozseká na jednotlivé termíny. Ty se pak samy objeví na stránce s rezervacemi.">
                    <div class="row">
                        <label for="hh_rez_od" class="col-4 o_light_label"/>
                        <field name="hh_rez_od" widget="float_time" class="col-2"/>
                    </div>
                    <div class="row">
                        <label for="hh_rez_do" class="col-4 o_light_label"/>
                        <field name="hh_rez_do" widget="float_time" class="col-2"/>
                    </div>
                    <!--
                        Druhe az ctvrte pasmo. Nechaji se na nule, kdyz
                        se hovory beru cely den v kuse; vyplni se, kdyz
                        ma byt mezi nimi dira - treba poledni pauza.
                    -->
                    <div class="row">
                        <label for="hh_rez_od2" class="col-4 o_light_label"/>
                        <field name="hh_rez_od2" widget="float_time" class="col-2"/>
                    </div>
                    <div class="row">
                        <label for="hh_rez_do2" class="col-4 o_light_label"/>
                        <field name="hh_rez_do2" widget="float_time" class="col-2"/>
                    </div>
                    <div class="row">
                        <label for="hh_rez_od3" class="col-4 o_light_label"/>
                        <field name="hh_rez_od3" widget="float_time" class="col-2"/>
                    </div>
                    <div class="row">
                        <label for="hh_rez_do3" class="col-4 o_light_label"/>
                        <field name="hh_rez_do3" widget="float_time" class="col-2"/>
                    </div>
                    <div class="row">
                        <label for="hh_rez_od4" class="col-4 o_light_label"/>
                        <field name="hh_rez_od4" widget="float_time" class="col-2"/>
                    </div>
                    <div class="row">
                        <label for="hh_rez_do4" class="col-4 o_light_label"/>
                        <field name="hh_rez_do4" widget="float_time" class="col-2"/>
                    </div>
                    <div class="row">
                        <label for="hh_rez_delka" class="col-4 o_light_label"/>
                        <field name="hh_rez_delka" class="col-2"/>
                    </div>
                    <div class="row">
                        <label for="hh_rez_dopredu" class="col-4 o_light_label"/>
                        <field name="hh_rez_dopredu" class="col-2"/>
                    </div>
                </setting>
                <setting string="Ve které dny"
                         help="Ve vypnutých dnech se žádné termíny nevyrábějí.">
                    <div>
                        <field name="hh_rez_po"/>
                        <label for="hh_rez_po" class="me-3"/>
                        <field name="hh_rez_ut"/>
                        <label for="hh_rez_ut" class="me-3"/>
                        <field name="hh_rez_st"/>
                        <label for="hh_rez_st" class="me-3"/>
                        <field name="hh_rez_ct"/>
                        <label for="hh_rez_ct" class="me-3"/>
                    </div>
                    <div>
                        <field name="hh_rez_pa"/>
                        <label for="hh_rez_pa" class="me-3"/>
                        <field name="hh_rez_so"/>
                        <label for="hh_rez_so" class="me-3"/>
                        <field name="hh_rez_ne"/>
                        <label for="hh_rez_ne" class="me-3"/>
                    </div>
                </setting>
                <setting string="Vyrobit termíny hned" name="hh_generovat"
                         help="Jinak se doplní samy v noci. Tohle se hodí hned po změně rozvrhu, ať se výsledek dá zkontrolovat.">
                    <button name="hh_vygenerovat_terminy" type="object"
                            string="Vyrobit termíny podle rozvrhu"
                            class="btn-secondary"/>
                </setting>
            </block>

        </xpath>
    </field>
</record>

</odoo>
