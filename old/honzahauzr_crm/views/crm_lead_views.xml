<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Karta prilezitosti v nastence.

    Stitek "odkud prisel" uz zakladni karta ukazuje sama - crm ma na ni
    tag_ids s barvou podle stitku. Co na ni chybelo, je datum: bez nej
    se z nastenky nepozna, jestli registrace prisla dnes rano nebo pred
    tremi tydny, a poradi ve sloupci to neprozradi.
-->
<record id="crm_case_kanban_view_leads" model="ir.ui.view">
    <field name="name">crm.lead.kanban.lead.hh</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='tag_ids']" position="after">
            <div class="o_hh_prislo text-muted small">
                <i class="fa fa-clock-o me-1" role="img" aria-label="Přišlo"/>
                <field name="create_date"/>
            </div>
        </xpath>
        <!-- Barva karty podle stavu hovoru. Zelena = odkaz na hovor
             odesel, cervena = clovek si hovor zrusil.

             Trida nejde dat na kartu samotnou: <t t-name="card"> je
             sablona, ne prvek, a atributy na ni se nikam nepropisi.
             Proto se dovnitr vlozi neviditelna znacka a pozadi se
             obarvi pres :has() - viz static/src/css/nastenka.scss.

             Hodnotu pocita hh_stav_barva, viz models/crm_lead_meet.py. -->
        <xpath expr="//templates" position="before">
            <field name="hh_stav_barva"/>
        </xpath>
        <xpath expr="//t[@t-name='card']" position="inside">
            <span t-if="record.hh_stav_barva.raw_value"
                  t-attf-class="o_hh_stav o_hh_stav_{{ record.hh_stav_barva.raw_value }}"/>
        </xpath>
    </field>
</record>

<!--
    Filtry: aby slo jednim kliknutim vytahnout jen registrace do vyzvy
    nebo jen odbery novinek a nemuselo se to hledat pres stitky rucne.
-->
<record id="crm_case_tree_view_oppor_hh" model="ir.ui.view">
    <field name="name">crm.lead.search.hh</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
    <field name="arch" type="xml">
        <xpath expr="//filter[@name='assigned_to_me']" position="after">
            <separator/>
            <filter string="3denní výzva" name="hh_zdroj_vyzva"
                    domain="[('hh_zdroj', '=', 'vyzva')]"/>
            <filter string="Newsletter" name="hh_zdroj_newsletter"
                    domain="[('hh_zdroj', '=', 'newsletter')]"/>
        </xpath>
        <!-- Group By skupina nema name, string se jako selektor pouzit nesmi -
             proto se vesim za posledni filtr uvnitr ni. -->
        <xpath expr="//filter[@name='source']" position="after">
            <filter string="Odkud přišel" name="hh_zdroj_group"
                    context="{'group_by': 'hh_zdroj'}"/>
        </xpath>
    </field>
</record>


<!--
    Osobni odkaz do vyzvy primo na karte.

    Odkaz uz jako pole existuje (hh_vyzva_odkaz na crm.lead) a pouziva
    se v textech e-mailu pres {{ object.hh_vyzva_odkaz }}. Na karte
    ale videt nebyl, takze se nedalo overit, co konkretnimu cloveku
    odeslo - a hlavne se nedalo kliknutim podivat, co pod odkazem
    zrovna vidi.

    Ukazuje se jen u registraci do vyzvy. U odberu novinek nebo
    rezervace zadny takovy odkaz neexistuje a prazdne policko by jen
    pletlo. hh_zdroj se proto nacita taky, jinak by nebylo podle ceho
    se rozhodnout - a zustava skryte, protoze stejnou informaci uz
    nese barevny stitek.
-->
<record id="crm_lead_view_form_hh" model="ir.ui.view">
    <field name="name">crm.lead.form.hh</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
        <!-- Vesi se za stitky, ne za e-mail. Pole e-mailu a telefonu
             sedi ve vlastnim bloku bez popisku, takze odkaz vlozeny
             za nimi se vykreslil jako holy text pripojeny k adrese
             a nebylo poznat, co to je. -->
        <xpath expr="//field[@name='tag_ids']" position="after">
            <field name="hh_zdroj" invisible="1"/>
            <field name="hh_vyzva_odkaz" widget="url" readonly="1"
                   string="Odkaz do výzvy"
                   invisible="hh_zdroj != 'vyzva'"
                   help="Osobní odkaz, který tomuhle člověku chodí
                         v e-mailech. Klepnutím se otevře přesně to,
                         co pod ním právě vidí."/>
            <!-- Prodejni rada po vyzve. Pozastaveni zaskrtava Honza
                 rucne, kdyz mu clovek osobne odepise; odhlaseni se
                 nastavuje samo z paticky e-mailu, proto je jen
                 pro cteni. -->
            <field name="hh_serie_pozastavena"/>
            <field name="hh_odhlaseno" readonly="1"
                   invisible="not hh_odhlaseno"/>
            <!-- Kolik z videi clovek videl. Jeden radek, at karta
                 nenaroste - podrobnosti jsou ve Vykazech. Skryva se,
                 dokud nic nepustil; prazdne "1. – 2. – 3. –" by na
                 karte jen zabiralo misto. -->
            <field name="hh_sledovani_ids" invisible="1"/>
            <field name="hh_videa_souhrn" readonly="1" string="Videa výzvy"
                   invisible="not hh_sledovani_ids"
                   help="Kolik procent videa má člověk za sebou u každého
                         ze tří dnů. Fajfka = dokoukal."/>
            <!-- Odkud clovek prisel. Pole je Odoo (utm.mixin)
                 a plni se samo, viz models/crm_lead_puvod.py.
                 Odoo ho v zakladu schovava do zalozky Dalsi info,
                 kam Honza nechodi - tady je rovnou na karte.

                 Kanal a kampan na karte zamerne nejsou: Honza chce
                 vedet, jestli clovek prisel z Instagramu nebo
                 z Facebooku, a nic vic. Kdo je potrebuje, najde je
                 pod "Vice informaci" jako doposud. -->
            <field name="source_id" string="Odkud přišel"
                   options="{'no_create_edit': True}"
                   help="Instagram, Facebook, TikTok, Google… Pozná se
                         z adresy, kterou člověk přišel, nebo z webu,
                         ze kterého na nás kliknul."/>
            <!-- Odkaz na hovor. Ukazuje se jen u toho, kdo ma termin
                 domluveny - u ostatnich by to bylo policko, ktere
                 nema co delat. -->
            <field name="hh_meet_mozny" invisible="1"/>
            <field name="hh_meet_odeslano" invisible="1"/>
            <label for="hh_meet_odkaz" string="Odkaz na hovor"
                   invisible="not hh_meet_mozny"/>
            <div class="o_row" invisible="not hh_meet_mozny">
                <field name="hh_meet_odkaz" nolabel="1"
                       placeholder="https://meet.google.com/..."
                       class="oe_inline"/>
                <button name="action_hh_poslat_meet" type="object"
                        class="btn btn-danger ms-2"
                        string="Odeslat"
                        invisible="not hh_meet_odkaz"
                        confirm="Odejde zpráva s tlačítkem na tenhle odkaz. Poslat?"
                        help="Pošle člověku zprávu, ve které tlačítko vede na tenhle odkaz."/>
                <span class="text-muted ms-2"
                      invisible="not hh_meet_odeslano">
                    odesláno <field name="hh_meet_odeslano"
                                    widget="date" nolabel="1"
                                    class="oe_inline"/>
                </span>
            </div>
        </xpath>

        <!-- Na co ten člověk koukal. Souhrn nahoře odpoví na "došel
             výzvou?", tahle záložka na "a co ještě si pustil?" -
             celý seznam videí i mimo výzvu, s procenty.

             Jako záložka, ne na kartě: u člověka, který si projde
             půlku webu, by to byl dlouhý seznam a kontakt s e-mailem
             by se odsunul dolů. -->
        <xpath expr="//notebook" position="inside">
            <page string="Videa" name="hh_videa"
                  invisible="not hh_sledovani_ids">
                <field name="hh_sledovani_ids" readonly="1" nolabel="1">
                    <list create="false" edit="false" delete="false"
                          default_order="den, naposledy desc">
                        <field name="nazev" string="Video"/>
                        <field name="den" string="Den výzvy" optional="show"/>
                        <field name="stranka" string="Na stránce"/>
                        <field name="spusteno" string="Spustil"/>
                        <field name="procento" string="Zhlédnuto"
                               widget="progressbar"/>
                        <field name="dokoukano" string="Dokoukal"
                               widget="boolean_toggle" readonly="1"/>
                        <field name="nejdale" string="Nejdál (s)"
                               optional="hide"/>
                        <field name="delka" string="Délka (s)"
                               optional="hide"/>
                        <field name="naposledy" string="Naposledy"/>
                    </list>
                </field>
            </page>
        </xpath>
    </field>
</record>

</odoo>
