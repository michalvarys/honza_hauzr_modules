<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ================================================================
     NÁŠ NÁVRH V GALERII EDITORU

     Galerie, kterou editor nabídne u prázdné zprávy, se skládá ze
     šablony mass_mailing.email_designer_themes. Každá dlaždice je
     jeden div s názvem, titulkem a cestou k náhledům; editor si
     z té cesty složí dva obrázky: _small.png do dlaždice
     a _large.png do velkého náhledu.

     Obsah jsou bloky Odoo (o_mail_snippet_general). Jen takový blok
     umí editor vybrat, posunout, smazat a dát mezi něj jiný —
     a tlačítko jako <a class="btn btn-primary"> má volby, mezi
     nimi odkaz. Dřív tu byla jedna velká tabulka a zpráva z ní
     složená se dala jen přepsat.

     Bez data-nowrap schválně: obal (o_layout, container,
     .oe_structure) ať postaví editor sám. V něm je jediné místo,
     kam jdou pouštět bloky.

     data-layout-styles dává stránce kolem karty krémové pozadí,
     stejné jako mají ostatní zprávy.

     Soubor vyrábí nastroje/mail-tema.js, needituje se ručně.
     ================================================================ -->

<template id="theme_vr_vyzva" inherit_id="mass_mailing.email_designer_themes"
          name="Vlastní režie — návrh do galerie">
    <xpath expr="." position="inside">
        <div data-name="vr_vyzva"
             title="Vlastní režie"
             data-layout-styles="background-color:#f4efe6;"
             data-img="/honzahauzr_crm/static/src/img/tema_vr">
<style id="design-element">
.o_mail_wrapper { font-family: Helvetica, Arial, sans-serif; color: #5d554b; }
.o_mail_wrapper p { font-size: 16px; line-height: 1.65; margin: 0 0 18px 0; }
.o_mail_wrapper h1 { font-size: 28px; line-height: 1.25; font-weight: bold; color: #23211d; margin: 0 0 24px 0; }
.o_mail_wrapper .hh-eyebrow { font-size: 12px; letter-spacing: 1.6px; text-transform: uppercase; color: #a89681; margin: 0 0 14px 0; }
.o_mail_wrapper .hh-tmave { color: #23211d; }
.o_mail_wrapper .hh-drobne { font-size: 12px; line-height: 1.6; color: #8c8276; margin: 0; }
.o_mail_wrapper .hh-otazka { border-left: 3px solid #23211d; padding: 2px 0 2px 18px; font-size: 18px; line-height: 1.5; font-weight: bold; color: #23211d; margin: 0; }
.o_mail_wrapper .hh-ramecek { background-color: #f4efe6; border: 1px solid #e2dacb; padding: 20px 22px 4px 22px; }
.o_mail_wrapper .hh-ramecek p { color: #23211d; }
.o_mail_wrapper .hh-linka-nad { border-top: 1px solid #e2dacb; }
.o_mail_wrapper .hh-linka-pod { border-bottom: 1px solid #e2dacb; }
.o_mail_wrapper a.btn.btn-primary { background-color: #23211d; border-color: #23211d; color: #ffffff; font-size: 14px; letter-spacing: 1.2px; text-transform: uppercase; font-weight: bold; padding: 16px 34px; border-radius: 0; }
</style>
        <div class="s_header_logo o_mail_block_header_logo o_mail_snippet_general hh-linka-pod pt24 pb16">
          <div class="container">
            <div class="row">
              <div class="col-8">
                <img src="/theme_honzahauzr/static/src/img/vr/vr-logo-email.png" alt="Vlastní režie" width="190" style="width:190px;height:auto;" class="img-fluid"/>
              </div>
              <div class="col-4" style="text-align:right;">
                <p class="hh-eyebrow" style="margin:10px 0 0 0;">Honza Hauzr</p>
              </div>
            </div>
          </div>
        </div>
        <div class="s_text_block o_mail_snippet_general pt16 pb16" style="padding-left:15px;padding-right:15px;">
          <div class="container s_allow_columns">
            <p class="hh-eyebrow">Vlastní režie</p>
            <h1>Nadpis zprávy</h1>
            <p class="hh-tmave">&#123;&#123; object.hh_osloveni &#125;&#125;</p>
            <p>tenhle odstavec přepiš. Pod ním můžeš další bloky přidávat, posouvat i mazat — přetáhni si je z panelu vpravo.</p>
            <p>Tlačítko níž má zatím prázdný odkaz. Klikni na něj a v liště nahoře mu adresu doplň.</p>
          </div>
        </div>
        <div class="s_call_to_action o_mail_snippet_general pt8 pb24" style="text-align:center;">
          <div class="container">
            <a href="#" role="button" class="btn btn-primary">Text tlačítka</a>
          </div>
        </div>
        <div class="s_text_block o_mail_snippet_general hh-linka-nad pt24 pb24" style="padding-left:15px;padding-right:15px;">
          <div class="container s_allow_columns">
            <p class="hh-tmave"><strong>Honza</strong></p>
          </div>
        </div>
        <div class="s_text_block o_mail_snippet_general hh-linka-nad pt16 pb16" style="padding-left:15px;padding-right:15px;text-align:center;">
          <div class="container s_allow_columns">
            <p class="hh-drobne">&#123;&#123; object.hh_paticka_odesilatel &#125;&#125;<br/>Tenhle e-mail ti přišel, protože ses přihlásil do bezplatné výzvy Z autopilota zpět do života.<br/><a href="&#123;&#123; object.hh_odkaz_odhlaseni &#125;&#125;" style="text-decoration:underline;">Nechceš ode mě další e-maily? Odhlas se.</a></p>
          </div>
        </div>
        </div>
    </xpath>
</template>

<!-- ================================================================
     NÁVRHY ODOO Z GALERIE PRYČ

     Odoo jich tam dává čtrnáct — newsletter, kupón, konference…
     Honza žádný z nich nepoužije a mezi nimi by hledal ty svoje.
     Zůstávají jen naše.

     Vrátit se dá kterýkoliv: stačí vyškrtnout jeho jméno ze
     seznamu ODOO_NAVRHY v nastroje/mail-tema.js a soubor znovu
     vyrobit.
     ================================================================ -->

<template id="galerie_bez_navrhu_odoo"
          inherit_id="mass_mailing.email_designer_themes"
          name="Galerie bez návrhů Odoo">
        <xpath expr="//div[@data-name='basic']" position="replace"/>
        <xpath expr="//div[@data-name='empty']" position="replace"/>
        <xpath expr="//div[@data-name='default']" position="replace"/>
        <xpath expr="//div[@data-name='bignews']" position="replace"/>
        <xpath expr="//div[@data-name='blogging']" position="replace"/>
        <xpath expr="//div[@data-name='coffeebreak']" position="replace"/>
        <xpath expr="//div[@data-name='coupon']" position="replace"/>
        <xpath expr="//div[@data-name='event']" position="replace"/>
        <xpath expr="//div[@data-name='magazine']" position="replace"/>
        <xpath expr="//div[@data-name='newsletter']" position="replace"/>
        <xpath expr="//div[@data-name='promotion']" position="replace"/>
        <xpath expr="//div[@data-name='roadshow1']" position="replace"/>
        <xpath expr="//div[@data-name='roadshow2']" position="replace"/>
        <xpath expr="//div[@data-name='training']" position="replace"/>
</template>

</odoo>
