<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Sloupec nastenky nese jen stitky, zadne texty.

    Driv se u nej psal predmet a telo, a to ve trech pevnych trojicich
    poli - vic nez tri zpravy nesly a stejny text ve dvou radach se
    musel psat dvakrat. Ted se zpravy piši v knihovne e-mailu a tady
    se jen rekne, ktere rady se z toho sloupce posilaji.

    Kotva miri na oddelovac v sheetu podle pozice, ne podle jeho nazvu -
    nazev se preklada a v ceske databazi by 'Requirements' nesedelo.
    Vlozit se musi PRED nej: pri kotve na pole requirements skoncil
    blok pod nadpisem POZADAVKY a opticky k nemu patril.
-->
<record id="crm_stage_form_hh" model="ir.ui.view">
    <field name="name">crm.stage.form.honzahauzr</field>
    <field name="model">crm.stage</field>
    <field name="inherit_id" ref="crm.crm_stage_form"/>
    <field name="arch" type="xml">
        <!--
            Formular se z nastenky otevira v dialogu a ten se vejde na
            obrazovku jen tak tak - proto je tu jedno pole a dva radky
            textu, nic vic.
        -->
        <xpath expr="//sheet/separator[1]" position="before">
            <separator string="E-maily, které se odsud posílají"/>
            <group>
                <field name="hh_stitek_ids" widget="many2many_tags"
                       options="{'color_field': 'color', 'no_quick_create': False}"
                       placeholder="Přihoď řadu, třeba Třídenní výzva…"
                       nolabel="1" colspan="2"/>
                <field name="hh_maily_count" invisible="1"/>
            </group>
            <div class="text-muted small" invisible="hh_stitek_ids">
                Bez štítku se z tohohle sloupce nic neposílá – je to jen
                tvůj interní krok.
            </div>
            <div class="text-muted small" invisible="not hh_stitek_ids">
                Odejde <field name="hh_maily_count" class="oe_inline" readonly="1"/>
                zpráv. Co přesně a kolikátý den, se nastavuje
                v <b>E-maily &#8250; Knihovna e-mailů</b>. Odpočet běží
                u každého člověka zvlášť, od chvíle, kdy jeho karta
                do sloupce přijde.
            </div>
        </xpath>
    </field>
</record>

<!--
    Vlastni seznam sloupcu. Vychozi seznam stupnu ukazuje obchodni tym
    a vyhranou fazi, coz tady nikomu nic nerekne. Misto toho jsou videt
    rovnou rady, ktere se ze sloupce posilaji - daji se tak prihodit
    primo v seznamu, bez otevirani zaznamu.
-->
<record id="view_stupne_crm_list" model="ir.ui.view">
    <field name="name">crm.stage.list.honzahauzr</field>
    <field name="model">crm.stage</field>
    <field name="arch" type="xml">
        <list string="Sloupce nástěnky" editable="bottom">
            <field name="sequence" widget="handle"/>
            <field name="name" string="Název sloupce"/>
            <field name="hh_stitek_ids" widget="many2many_tags"
                   options="{'color_field': 'color', 'no_quick_create': False}"
                   string="Řady e-mailů"/>
            <field name="hh_maily_count" string="Odejde zpráv"/>
        </list>
    </field>
</record>

<record id="action_stupne_crm" model="ir.actions.act_window">
    <field name="name">Sloupce nástěnky</field>
    <field name="res_model">crm.stage</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_stupne_crm_list"/>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Zatím tu není žádný sloupec
        </p>
        <p>
            Sloupce obchodní nástěnky. U každého se dá přihodit řada
            e-mailů, která se pošle člověku, jakmile do sloupce přijde.
        </p>
    </field>
</record>

</odoo>
