<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Jedna polozka v horni liste, zbytek pod ni.

    Drive sedelo "Nastaveni sloupcu" primo v liste vedle Prodeje
    a Vykazu. S knihovnou e-mailu a stitky by tam stala vedle sebe
    uz ctyri vlastni polozka a lista by se tim rozjela. Rozbalovaci
    nabidka je drzi pod sebou, stejne jako to ma Odoo u Prodeje.

    Terminy hovoru zustavaji samostatne - to neni nastaveni, ale
    kalendar, do ktereho Honza chodi kazdy den.
-->
<menuitem id="menu_hh_nastaveni"
          name="Nastavení"
          parent="crm.crm_menu_root"
          sequence="30"/>

<menuitem id="menu_stupne_crm"
          name="Sloupce nástěnky"
          parent="menu_hh_nastaveni"
          action="action_stupne_crm"
          sequence="10"/>

<menuitem id="menu_hh_mail_sablona"
          name="Knihovna e-mailů"
          parent="menu_hh_nastaveni"
          action="action_hh_mail_sablona"
          sequence="20"/>

<menuitem id="menu_hh_mail_stitek"
          name="Štítky e-mailů"
          parent="menu_hh_nastaveni"
          action="action_hh_mail_stitek"
          sequence="30"/>

<!--
    Zhlednuti videi patri do Vykazu, ne do Nastaveni. Neni to nic,
    co by se nastavovalo - je to cislo, na ktere se Honza chodi
    divat, a hleda ho tam, kde ma Odoo ostatni prehledy.
-->
<menuitem id="menu_hh_vyzva_sledovani"
          name="Zhlédnutí videí"
          parent="crm.crm_menu_report"
          action="action_hh_vyzva_sledovani"
          sequence="40"/>

<menuitem id="menu_hh_zdroje"
          name="Odkud lidé chodí"
          parent="crm.crm_menu_report"
          action="action_crm_lead_zdroje"
          sequence="41"/>

<menuitem id="menu_hh_web_klik"
          name="Kam lidé klikají"
          parent="crm.crm_menu_report"
          action="action_hh_web_klik"
          sequence="42"/>

</odoo>
