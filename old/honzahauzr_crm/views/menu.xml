<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- =================================================================
     VLASTNÍ APLIKACE "HONZA ADMIN"

     Všechno, co jsme pro Honzu naprogramovali, sedělo rozstrkané
     v CRM: termíny hovorů a nastavení v horní liště vedle Prodeje,
     přehledy schované mezi Výkazy Odoo. Honza musel vědět, že se to
     hledá v CRM, a mezi cizími položkami to zanikalo.

     Teď je to samostatná dlaždice v nabídce aplikací. Rozložení
     uvnitř je stejné jako bylo v CRM - jen cesta k němu je jiná.

     Kořenová položka má stejná práva jako CRM (prodejce / vedoucí
     prodeje). Bez nich by se aplikace ukázala každému vnitřnímu
     uživateli, protože kořenové nabídky se jinak nefiltrují.
     ================================================================= -->
<menuitem id="menu_hh_admin"
          name="Honza Admin"
          web_icon="honzahauzr_crm,static/description/icon.png"
          groups="sales_team.group_sale_salesman,sales_team.group_sale_manager"
          sequence="6"/>

<!-- =================================================================
     NÁSTĚNKA

     Úplně první položka, takže se otevře po kliknutí na dlaždici.
     Je to obrazovka, kterou má Honza otevřenou celý den - kdyby
     kvůli ní musel přepínat do CRM, byla by aplikace k ničemu.

     Je to tatáž nástěnka jako v CRM: stejné karty, stejné sloupce,
     stejná tlačítka. Nic se nekopíruje, jen k ní vede další cesta.

     Záměrně crm_lead_opportunities, ne "Mé příležitosti" z CRM -
     ta má zapnuté filtrování na přihlášeného člověka. Honza chce
     vidět všechny karty, ne jen svoje.
     ================================================================= -->
<menuitem id="menu_hh_nastenka"
          name="Nástěnka"
          parent="menu_hh_admin"
          action="crm.crm_lead_opportunities"
          sequence="5"/>

<!--
    Termíny hovorů jsou druhá položka - obrazovka, do které Honza
    chodí každý den. Samotná nabídka je v hh_termin_views.xml
    u akcí, na které odkazuje.
-->

<!-- =================================================================
     VÝKAZY

     Čísla, na která se Honza chodí dívat. V CRM seděla pod
     stejnojmennou nabídkou Odoo, tady mají svoji.
     ================================================================= -->
<menuitem id="menu_hh_vykazy"
          name="Výkazy"
          parent="menu_hh_admin"
          sequence="30"/>

<menuitem id="menu_hh_vyzva_sledovani"
          name="Zhlédnutí videí"
          parent="menu_hh_vykazy"
          action="action_hh_vyzva_sledovani"
          sequence="10"/>

<menuitem id="menu_hh_zdroje"
          name="Odkud lidé chodí"
          parent="menu_hh_vykazy"
          action="action_crm_lead_zdroje"
          sequence="20"/>

<menuitem id="menu_hh_web_klik"
          name="Kam lidé klikají"
          parent="menu_hh_vykazy"
          action="action_hh_web_klik"
          sequence="30"/>

<!-- =================================================================
     NASTAVENÍ

     Stejné tři položky a ve stejném pořadí, jako byly v CRM.
     ================================================================= -->
<menuitem id="menu_hh_nastaveni"
          name="Nastavení"
          parent="menu_hh_admin"
          sequence="40"/>

<menuitem id="menu_stupne_crm"
          name="Sloupce nástěnky"
          parent="menu_hh_nastaveni"
          action="action_stupne_crm"
          sequence="10"/>

<menuitem id="menu_hh_mail_sablona"
          name="Knihovna e-mailů"
          parent="menu_hh_nastaveni"
          action="action_hh_mail_sablona"
          sequence="20"/>

<menuitem id="menu_hh_mail_stitek"
          name="Řady e-mailů"
          parent="menu_hh_nastaveni"
          action="action_hh_mail_stitek"
          sequence="30"/>

<!--
    Rodiče na už běžící databázi dorovná funkce v
    data/presun_menu.xml. Je až na konci manifestu, protože v tu
    chvíli už musí existovat i nabídky z hh_termin_views.xml.
-->

</odoo>
