<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="honzahauzr_crm.HhAdmin">
    <div class="hha">

        <!-- ===== LISTA ===== -->
        <div class="hha-lista">
            <span class="hha-znacka">Honza Hauzr</span>

            <nav class="hha-zalozky">
                <t t-foreach="zalozky" t-as="z" t-key="z.klic">
                    <button class="hha-zalozka"
                            t-att-class="{ 'hha-zalozka--aktivni': stav.obrazovka === z.klic }"
                            t-on-click="() => this.prepni(z.klic)"
                            t-esc="z.popis"/>
                </t>
            </nav>

            <!-- Rozbalovaci nabidka, polozky pod sebou. Vedle ni
                 veci, na ktere se chodi primo. -->
            <div class="hha-nabidka">
                <button class="hha-tlacitko"
                        t-att-class="{ 'hha-tlacitko--aktivni': stav.obrazovka === 'sekvence' or stav.obrazovka === 'stitky' }"
                        t-on-click="prepniNabidku">
                    E-maily <span class="hha-sipka">▾</span>
                </button>
                <div class="hha-nabidka__seznam" t-if="stav.nabidka">
                    <button class="hha-nabidka__polozka"
                            t-on-click="() => this.prepni('sekvence')">Sekvence e-mailů</button>
                    <button class="hha-nabidka__polozka"
                            t-on-click="() => this.prepni('stitky')">Štítky e-mailů</button>
                </div>
            </div>

            <button class="hha-tlacitko" t-on-click="otevriKalendar">Termíny hovorů</button>
            <button class="hha-tlacitko" t-on-click="otevriNastenku">Nástěnka</button>
        </div>

        <!-- ===== CISLA ===== -->
        <div class="hha-karty" t-if="stav.cisla">
            <div class="hha-karta">
                <span class="hha-karta__cislo" t-esc="stav.cisla.lidi"/>
                <span class="hha-karta__popis">lidí v CRM</span>
            </div>
            <div class="hha-karta">
                <span class="hha-karta__cislo" t-esc="stav.cisla.vyzva"/>
                <span class="hha-karta__popis">ve výzvě</span>
            </div>
            <div class="hha-karta">
                <span class="hha-karta__cislo" t-esc="stav.cisla.hovory"/>
                <span class="hha-karta__popis">hovorů před sebou</span>
            </div>
            <div class="hha-karta">
                <span class="hha-karta__cislo" t-esc="stav.cisla.maily"/>
                <span class="hha-karta__popis">odeslaných e-mailů</span>
            </div>
        </div>

        <t t-if="stav.nacita">
            <div class="hha-prazdno">Načítám…</div>
        </t>

        <t t-elif="!stav.data">
            <div class="hha-prazdno">Nic k zobrazení.</div>
        </t>

        <t t-else="">

            <!-- ===== NASTENKA ===== -->
            <t t-if="stav.obrazovka === 'nastenka'">
                <div class="hhn-deska">
                    <t t-foreach="stav.data" t-as="sloupec" t-key="sloupec.id">
                        <div class="hhn-sloupec"
                             t-on-dragover="nadSloupcem"
                             t-on-drop="() => this.pustNaSloupec(sloupec)">
                            <header class="hhn-sloupec__hlava">
                                <span class="hhn-sloupec__nazev" t-esc="sloupec.nazev"/>
                                <span class="hhn-sloupec__pocet" t-esc="sloupec.celkem"/>
                            </header>

                            <div class="hhn-sloupec__karty">
                                <t t-foreach="sloupec.karty" t-as="karta" t-key="karta.id">
                                    <article class="hhn-karta" draggable="true"
                                             t-on-dragstart="() => this.zacniTahnout(karta, sloupec)"
                                             t-on-click="() => this.otevriLead(karta.id)">
                                        <h3 class="hhn-karta__nazev" t-esc="karta.name"/>
                                        <p class="hhn-karta__kdo" t-if="karta.contact_name"
                                           t-esc="karta.contact_name"/>
                                        <div class="hhn-karta__stitky">
                                            <t t-foreach="karta.stitky" t-as="s" t-key="s_index">
                                                <span class="hhn-karta__stitek" t-esc="s"/>
                                            </t>
                                        </div>
                                        <p class="hhn-karta__paticka">
                                            <span t-esc="karta.kdy"/>
                                            <span class="hhn-karta__mail" t-if="karta.email_from"
                                                  t-esc="karta.email_from"/>
                                        </p>
                                    </article>
                                </t>

                                <div class="hhn-sloupec__prazdno" t-if="!sloupec.karty.length">
                                    Sem přetáhni kartu.
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>

            <!-- ===== LIDE ===== -->
            <t t-if="stav.obrazovka === 'lide'">
                <div class="hha-filtr">
                    <input class="hha-hledani" type="search" placeholder="Hledat jméno, e-mail nebo telefon…"
                           t-att-value="stav.hledani" t-on-change="hledej"/>
                    <select class="hha-vyber" t-on-change="filtrujStupen">
                        <option value="">Všechny fáze</option>
                        <t t-foreach="stav.data.stupne" t-as="s" t-key="s.id">
                            <option t-att-value="s.id" t-att-selected="stav.stupen === s.id" t-esc="s.name"/>
                        </t>
                    </select>
                    <span class="hha-pocet">
                        <t t-esc="stav.data.lide.length"/> z <t t-esc="stav.data.celkem"/>
                    </span>
                </div>

                <table class="hha-tabulka">
                    <thead>
                        <tr>
                            <th>Jméno</th>
                            <th>Kontakt</th>
                            <th>Fáze</th>
                            <th>Odkud</th>
                            <th>Štítky</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="stav.data.lide" t-as="l" t-key="l.id">
                            <tr t-on-click="() => this.otevriLead(l.id)">
                                <td class="hha-tabulka__jmeno" t-esc="l.contact_name or l.name"/>
                                <td>
                                    <span class="hha-radek" t-esc="l.email_from or ''"/>
                                    <span class="hha-radek hha-tichy" t-esc="l.phone or ''"/>
                                </td>
                                <td><span class="hha-faze" t-esc="l.stupen"/></td>
                                <td>
                                    <span class="hha-radek" t-esc="l.zdroj"/>
                                    <span class="hha-radek hha-tichy" t-esc="l.web"/>
                                </td>
                                <td>
                                    <t t-foreach="l.stitky" t-as="s" t-key="s_index">
                                        <span class="hha-stitek" t-esc="s"/>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <tr t-if="!stav.data.lide.length">
                            <td colspan="5" class="hha-prazdno">Nikdo tu neodpovídá hledání.</td>
                        </tr>
                    </tbody>
                </table>
            </t>

            <!-- ===== VYZVA ===== -->
            <t t-if="stav.obrazovka === 'vyzva'">
                <t t-if="!stav.data.lide.length">
                    <div class="hha-prazdno">Ve výzvě teď nikdo není.</div>
                </t>
                <table class="hha-tabulka" t-else="">
                    <thead>
                        <tr>
                            <th>Jméno</th>
                            <th>Ve výzvě od</th>
                            <th>Dny</th>
                            <th>Osobní odkaz</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="stav.data.lide" t-as="l" t-key="l.id">
                            <tr>
                                <td class="hha-tabulka__jmeno" t-on-click="() => this.otevriLead(l.id)">
                                    <span class="hha-radek" t-esc="l.jmeno"/>
                                    <span class="hha-radek hha-tichy" t-esc="l.email"/>
                                </td>
                                <td t-esc="l.od"/>
                                <td>
                                    <t t-foreach="l.dny" t-as="d" t-key="d.cislo">
                                        <span class="hha-den"
                                              t-att-class="{ 'hha-den--odemceno': d.odemceno }"
                                              t-att-title="d.odemceno ? 'Odemčeno' : ('Odemkne se za ' + d.zbyva + ' h')">
                                            <t t-esc="d.cislo"/>
                                        </span>
                                    </t>
                                    <span class="hha-tichy" t-if="!l.dny.length">zatím nezačal</span>
                                </td>
                                <td>
                                    <a t-if="l.maKlic" class="hha-odkaz" t-att-href="l.odkaz"
                                       target="_blank" rel="noopener">otevřít</a>
                                    <span class="hha-tichy" t-else="">nemá klíč</span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

            <!-- ===== HOVORY ===== -->
            <t t-if="stav.obrazovka === 'hovory'">
                <h2 class="hha-nadpis">Domluvené hovory</h2>
                <t t-if="!stav.data.rezervovane.length">
                    <div class="hha-prazdno">Žádný hovor před sebou nemáš.</div>
                </t>
                <table class="hha-tabulka" t-else="">
                    <thead>
                        <tr>
                            <th>Kdy</th>
                            <th>Kdo</th>
                            <th>Kontakt</th>
                            <th>Poznámka</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="stav.data.rezervovane" t-as="r" t-key="r.id">
                            <tr>
                                <td class="hha-tabulka__jmeno" t-esc="r.kdy"/>
                                <td t-esc="r.jmeno or ''"/>
                                <td>
                                    <span class="hha-radek" t-esc="r.email or ''"/>
                                    <span class="hha-radek hha-tichy" t-esc="r.telefon or ''"/>
                                </td>
                                <td class="hha-tichy" t-esc="r.poznamka or ''"/>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <h2 class="hha-nadpis">Volné termíny napřed</h2>
                <div class="hha-volne">
                    <t t-foreach="stav.data.volne" t-as="v" t-key="v.den">
                        <div class="hha-volne__den">
                            <span class="hha-volne__datum" t-esc="v.den"/>
                            <span class="hha-volne__pocet" t-esc="v.pocet"/>
                        </div>
                    </t>
                    <div class="hha-prazdno" t-if="!stav.data.volne.length">
                        Na nejbližší tři týdny nejsou volné termíny.
                    </div>
                </div>
            </t>

            <!-- ===== SEKVENCE ===== -->
            <t t-if="stav.obrazovka === 'sekvence'">
                <div class="hha-obsah">
                    <t t-if="!stav.data.length">
                        <div class="hha-prazdno">
                            Zatím tu nejsou žádné štítky. Založ si je ve Štítcích
                            a pak k nim přidej zprávy.
                        </div>
                    </t>
                    <t t-foreach="stav.data" t-as="stitek" t-key="stitek.id">
                        <section class="hhm-stitek">
                            <header class="hhm-stitek__hlava">
                                <h2 class="hhm-stitek__nazev" t-esc="stitek.name"/>
                                <span class="hhm-stitek__pocet">
                                    <t t-esc="stitek.zpravy.length"/>
                                    <t t-if="stitek.zpravy.length === 1"> zpráva</t>
                                    <t t-elif="stitek.zpravy.length &gt;= 2 and stitek.zpravy.length &lt;= 4"> zprávy</t>
                                    <t t-else=""> zpráv</t>
                                </span>
                                <button class="hhm-tlacitko hhm-tlacitko--tichy"
                                        t-on-click="() => this.pridejZpravu(stitek)">Přidat zprávu</button>
                            </header>

                            <t t-if="!stitek.zpravy.length">
                                <div class="hhm-stitek__prazdno">
                                    Na tenhle štítek se zatím nic neposílá.
                                </div>
                            </t>

                            <ol class="hhm-rada" t-else="">
                                <t t-foreach="stitek.zpravy" t-as="zprava" t-key="zprava.id">
                                    <li class="hhm-zprava"
                                        t-att-class="{ 'hhm-zprava--vypnuta': !zprava.zapnuto }">
                                        <span class="hhm-zprava__kdy" t-esc="kdy(zprava)"/>
                                        <div class="hhm-zprava__text"
                                             t-on-click="() => this.otevriZpravu(zprava.id)">
                                            <span class="hhm-zprava__predmet" t-esc="zprava.predmet or zprava.name"/>
                                            <span class="hhm-zprava__nazev" t-esc="zprava.name"/>
                                        </div>
                                        <button class="hhm-prepinac"
                                                t-att-class="{ 'hhm-prepinac--zap': zprava.zapnuto }"
                                                t-att-title="zprava.zapnuto ? 'Odesílá se' : 'Neodesílá se'"
                                                t-on-click="() => this.prepniOdesilani(zprava)">
                                            <span class="hhm-prepinac__kolecko"/>
                                        </button>
                                        <button class="hhm-tlacitko hhm-tlacitko--tichy"
                                                t-on-click="() => this.otevriZpravu(zprava.id)">Upravit</button>
                                    </li>
                                </t>
                            </ol>
                        </section>
                    </t>
                </div>
            </t>

            <!-- ===== STITKY ===== -->
            <t t-if="stav.obrazovka === 'stitky'">
                <div class="hha-filtr">
                    <span class="hha-pocet"><t t-esc="stav.data.length"/> štítků</span>
                    <button class="hha-tlacitko hha-tlacitko--svetly"
                            t-on-click="pridejStitek">Nový štítek</button>
                </div>
                <table class="hha-tabulka">
                    <thead>
                        <tr>
                            <th>Štítek</th>
                            <th>Zpráv</th>
                            <th>Odesílá se</th>
                            <th>Používají ho fáze</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="stav.data" t-as="s" t-key="s.id">
                            <tr t-on-click="() => this.otevriStitek(s.id)">
                                <td class="hha-tabulka__jmeno" t-esc="s.name"/>
                                <td t-esc="s.zprav"/>
                                <td>
                                    <span t-esc="s.zapnutych"/>
                                    <span class="hha-tichy" t-if="s.zprav !== s.zapnutych">
                                        (<t t-esc="s.zprav - s.zapnutych"/> vypnuto)
                                    </span>
                                </td>
                                <td>
                                    <t t-foreach="s.sloupce" t-as="f" t-key="f_index">
                                        <span class="hha-faze" t-esc="f"/>
                                    </t>
                                    <span class="hha-tichy" t-if="!s.sloupce.length">žádná</span>
                                </td>
                            </tr>
                        </t>
                        <tr t-if="!stav.data.length">
                            <td colspan="4" class="hha-prazdno">Zatím žádné štítky.</td>
                        </tr>
                    </tbody>
                </table>
            </t>

            <!-- ===== STATISTIKY ===== -->
            <t t-if="stav.obrazovka === 'statistiky'">
                <div class="hha-mrizka">

                    <section class="hha-blok">
                        <h2 class="hha-nadpis">Kdo kde stojí</h2>
                        <t t-foreach="stav.data.stupne" t-as="s" t-key="s.nazev">
                            <div class="hha-pruh">
                                <span class="hha-pruh__popis" t-esc="s.nazev"/>
                                <span class="hha-pruh__cara">
                                    <span class="hha-pruh__vypln"
                                          t-attf-style="width: {{ vyska(s.pocet, stav.data.stupne) }}"/>
                                </span>
                                <span class="hha-pruh__cislo" t-esc="s.pocet"/>
                            </div>
                        </t>
                    </section>

                    <section class="hha-blok">
                        <h2 class="hha-nadpis">Odkud lidé chodí</h2>
                        <t t-foreach="stav.data.zdroje" t-as="z" t-key="z.nazev">
                            <div class="hha-pruh">
                                <span class="hha-pruh__popis" t-esc="z.nazev"/>
                                <span class="hha-pruh__cara">
                                    <span class="hha-pruh__vypln"
                                          t-attf-style="width: {{ vyska(z.pocet, stav.data.zdroje) }}"/>
                                </span>
                                <span class="hha-pruh__cislo" t-esc="z.pocet"/>
                            </div>
                        </t>
                    </section>

                    <section class="hha-blok hha-blok--siroky">
                        <h2 class="hha-nadpis">Přírůstek po týdnech</h2>
                        <div class="hha-sloupce">
                            <t t-foreach="stav.data.tydny" t-as="t" t-key="t.popis">
                                <div class="hha-sloupec">
                                    <span class="hha-sloupec__cislo" t-esc="t.pocet"/>
                                    <span class="hha-sloupec__vypln"
                                          t-attf-style="height: {{ vyska(t.pocet, stav.data.tydny) }}"/>
                                    <span class="hha-sloupec__popis" t-esc="t.popis"/>
                                </div>
                            </t>
                        </div>
                    </section>

                </div>
            </t>

        </t>

    </div>
</t>

</templates>
