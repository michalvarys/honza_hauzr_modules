<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<!-- ================================================================ -->
<!-- LANDING PAGE - all content inlined for independent editing       -->
<!-- ================================================================ -->
<template id="hh_page_landing" name="Honza Hauzr Landing">
    <t t-call="website.layout">
        <t t-set="no_header" t-value="True"/>
        <t t-set="no_footer" t-value="True"/>
        <t t-set="additional_title">Honza Hauzr | Začni žít naplno</t>
        <t t-set="meta_description">Pomáhám lidem, kteří fungují na autopilotu, vrátit si směr, hranice a respekt k sobě. Domluv si nezávazný úvodní hovor.</t>

        <div id="wrap" class="oe_structure oe_empty hh-landing">

            <!-- NAVIGACE -->
            <nav class="hh-nav">
                <a href="#hero" class="hh-nav__brand">Honza Hauzr</a>
                <div class="hh-nav__links">
                    <a href="#o-mne">O mně</a>
                    <a href="#jak-pracuji">Jak pracuji</a>
                    <a href="#kontakt" class="hh-btn hh-btn--primary">Domluvit úvodní hovor</a>
                </div>
            </nav>

            <!-- 1. UVODNI OBRAZOVKA -->
            <!-- Fotka je na pozadi sekce pres oe_img_bg, aby sla v Odoo editoru
                 vymenit pres volbu Pozadi (jako obrazek v <img> by byla schovana
                 pod textem a nesla by poradne kliknout). -->
            <section class="hh-hero o_cc o_colored_level oe_img_bg o_bg_img_center" id="hero"
                     style="background-image: url('/theme_honzahauzr/static/src/img/hero-balon.webp'); background-size: cover; background-position: center;">
                <div class="hh-hero__bg"/>
                <div class="container">
                    <div class="hh-hero__content">
                        <p class="hh-hero__tagline" data-anim="fade-up">
                            Osobní rozvoj &#8226; Koučink &#8226; Mentoring
                        </p>
                        <h1 data-anim="fade-up" data-delay="150">
                            Začni žít život,<br/>který <em>stojí za to</em>
                        </h1>
                        <p class="hh-hero__sub" data-anim="fade-up" data-delay="300">
                            Pomáhám lidem, kteří fungují na autopilotu, vrátit si směr,
                            hranice a respekt k sobě.
                        </p>
                        <div class="hh-hero__ctas" data-anim="fade-up" data-delay="450">
                            <a href="#kontakt" class="hh-btn hh-btn--primary hh-btn--large">Domluvit úvodní hovor</a>
                            <a href="#o-mne" class="hh-btn hh-btn--ghost">Můj příběh</a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 2. PROBLEMY -->
            <section class="hh-pain o_cc o_colored_level" id="problemy">
                <div class="container">
                    <div class="hh-pain__grid">
                        <div class="hh-pain__visual" data-anim="fade-right">
                            <div class="hh-photo">
                                <img src="/theme_honzahauzr/static/src/img/cesta-vychod.webp" alt="Východ slunce nad horami"/>
                            </div>
                        </div>
                        <div class="hh-pain__content">
                            <span class="hh-badge hh-badge--red" data-anim="fade-up">Poznáváš se?</span>
                            <h2 style="margin-top: 20px" data-anim="fade-up" data-delay="100">
                                Většina lidí žije<br/>na <span class="hh-text-gradient">autopilotu</span>
                            </h2>
                            <div class="hh-pain__item" data-anim="fade-left" data-delay="200">
                                <div class="hh-pain__item-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4a90d9" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                                </div>
                                <div>
                                    <h3>Autopilot</h3>
                                    <p>Dny splývají. Vstaneš, odpracuješ, usneš. A zítra znovu.</p>
                                </div>
                            </div>
                            <div class="hh-pain__item" data-anim="fade-left" data-delay="280">
                                <div class="hh-pain__item-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4a90d9" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                </div>
                                <div>
                                    <h3>Respekt k sobě</h3>
                                    <p>Sliby druhým držíš. Ty vlastní porušuješ první.</p>
                                </div>
                            </div>
                            <div class="hh-pain__item" data-anim="fade-left" data-delay="360">
                                <div class="hh-pain__item-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4a90d9" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
                                </div>
                                <div>
                                    <h3>Hranice</h3>
                                    <p>Říkáš ano, když chceš říct ne. Pak se na sebe zlobíš.</p>
                                </div>
                            </div>
                            <div class="hh-pain__item" data-anim="fade-left" data-delay="440">
                                <div class="hh-pain__item-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4a90d9" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M15 9l-2.5 5.5L7 17l2.5-5.5z"/></svg>
                                </div>
                                <div>
                                    <h3>Směr</h3>
                                    <p>Víš přesně, co nechceš. Co chceš, je mlha.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 3. MUJ PRIBEH - DRIV / DNES -->
            <section class="hh-story o_cc o_colored_level" id="o-mne">
                <div class="container">
                    <div class="hh-story__header">
                        <span class="hh-badge hh-badge--warm" data-anim="fade-up">Můj příběh</span>
                        <h2 style="margin-top: 18px" data-anim="fade-up" data-delay="100">
                            Nemluvím o tom<br/>z <span class="hh-text-gradient">učebnice</span>
                        </h2>
                        <p data-anim="fade-up" data-delay="200">
                            Tohle nejsou dvě fotky pro efekt. Je to rozdíl mezi člověkem,
                            který svůj život odbýval, a člověkem, který si ho vzal zpátky.
                        </p>
                    </div>
                    <div class="hh-story__pair">
                        <div class="hh-story__card" data-anim="fade-right" data-delay="150">
                            <div class="hh-story__photo">
                                <span class="hh-story__tag hh-story__tag--driv">Dřív</span>
                                <img src="/theme_honzahauzr/static/src/img/pribeh-driv.webp" alt="Honza Hauzr dřív"/>
                            </div>
                            <div class="hh-story__caption">
                                <h3>Utíkal jsem před sebou</h3>
                                <p>Pivo, cigareta, další víkend pryč. Vypadalo to jako pohoda. Byl to únik.</p>
                            </div>
                        </div>
                        <div class="hh-story__card" data-anim="fade-left" data-delay="250">
                            <div class="hh-story__photo">
                                <span class="hh-story__tag hh-story__tag--dnes">Dnes</span>
                                <img src="/theme_honzahauzr/static/src/img/pribeh-dnes.webp" alt="Honza Hauzr dnes"/>
                            </div>
                            <div class="hh-story__caption">
                                <h3>Vím, kam jdu</h3>
                                <p>Ne proto, že mám vyřešeno. Proto, že jsem přestal čekat, až to přijde samo.</p>
                            </div>
                        </div>
                    </div>
                    <div class="hh-story__cesta">
                        <p class="hh-story__cesta-note" data-anim="fade-up">
                            Tohle je moje cesta, ne návod. Ta tvoje bude vypadat jinak
                            a je to tak v pořádku.
                        </p>
                        <p class="hh-story__swipe">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                            Projeď prstem
                        </p>
                        <div class="hh-story__grid">
                            <div class="hh-photo" data-anim="zoom-in"><img src="/theme_honzahauzr/static/src/img/cesta-seskok.webp" alt="Seskok padákem"/></div>
                            <div class="hh-photo" data-anim="zoom-in" data-delay="80"><img src="/theme_honzahauzr/static/src/img/cesta-ferrata.webp" alt="Via ferrata"/></div>
                            <div class="hh-photo" data-anim="zoom-in" data-delay="160"><img src="/theme_honzahauzr/static/src/img/cesta-canyoning.webp" alt="Canyoning"/></div>
                            <div class="hh-photo" data-anim="zoom-in" data-delay="240"><img src="/theme_honzahauzr/static/src/img/cesta-paragliding.webp" alt="Paragliding"/></div>
                            <div class="hh-photo" data-anim="zoom-in" data-delay="320"><img src="/theme_honzahauzr/static/src/img/cesta-hory.webp" alt="V horách"/></div>
                            <div class="hh-photo" data-anim="zoom-in" data-delay="400"><img src="/theme_honzahauzr/static/src/img/cesta-vychod.webp" alt="Východ slunce"/></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 4. JAK PRACUJI -->
            <section class="hh-approach o_cc o_colored_level" id="jak-pracuji">
                <div class="container">
                    <div class="hh-approach__header">
                        <span class="hh-badge hh-badge--warm" data-anim="fade-up">Jak pracuji</span>
                        <h2 style="margin-top: 18px" data-anim="fade-up" data-delay="100">
                            Žádné zázraky.<br/><span class="hh-text-gradient">Poctivá práce.</span>
                        </h2>
                        <p data-anim="fade-up" data-delay="200">
                            Nejsem guru a nebudu ti říkat, jak máš žít. Pomůžu ti pojmenovat,
                            co ti nefunguje, a udržet tě u toho, co sis sám rozhodl.
                        </p>
                    </div>
                    <div class="hh-approach__grid">
                        <div class="hh-approach__item" data-anim="fade-up" data-delay="100">
                            <input type="checkbox" class="hh-acc__toggle" id="hh-acc-pristup"/>
                            <label class="hh-approach__head" for="hh-acc-pristup">
                                <span class="hh-approach__icon">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4a90d9" stroke-width="2" stroke-linecap="round"><path d="M12 3a6 6 0 0 0-3 11v3h6v-3a6 6 0 0 0-3-11z"/><path d="M10 21h4"/></svg>
                                </span>
                                <h3>Přístup</h3>
                                <span class="hh-acc__chev">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                                </span>
                            </label>
                            <div class="hh-approach__body">
                                <p>Mluvíme na rovinu. Neomílám fráze, ptám se na to, čemu se vyhýbáš. Bez souzení, ale i bez hlazení po hlavě.</p>
                            </div>
                        </div>
                        <div class="hh-approach__item" data-anim="fade-up" data-delay="200">
                            <input type="checkbox" class="hh-acc__toggle" id="hh-acc-odpovednost"/>
                            <label class="hh-approach__head" for="hh-acc-odpovednost">
                                <span class="hh-approach__icon">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4a90d9" stroke-width="2" stroke-linecap="round"><path d="M9 11l3 3 8-8"/><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/></svg>
                                </span>
                                <h3>Odpovědnost</h3>
                                <span class="hh-acc__chev">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                                </span>
                            </label>
                            <div class="hh-approach__body">
                                <p>Rozhodnutí jsou tvoje. Moje práce je hlídat, že u nich zůstaneš i ve chvíli, kdy se ti nechce.</p>
                            </div>
                        </div>
                        <div class="hh-approach__item" data-anim="fade-up" data-delay="300">
                            <input type="checkbox" class="hh-acc__toggle" id="hh-acc-kroky"/>
                            <label class="hh-approach__head" for="hh-acc-kroky">
                                <span class="hh-approach__icon">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4a90d9" stroke-width="2" stroke-linecap="round"><path d="M4 20h16"/><path d="M6 20V10"/><path d="M12 20V4"/><path d="M18 20v-7"/></svg>
                                </span>
                                <h3>Konkrétní kroky</h3>
                                <span class="hh-acc__chev">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                                </span>
                            </label>
                            <div class="hh-approach__body">
                                <p>Z každého setkání odcházíš s něčím, co uděláš tenhle týden. Ne s pocitem, že to bylo hezké povídání.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 5. UVODNI HOVOR -->
            <!-- Fotka na pozadi sekce, vymenitelna v Odoo editoru pres volbu Pozadi. -->
            <section class="hh-final-cta o_cc o_colored_level oe_img_bg o_bg_img_center" id="kontakt"
                     style="background-image: url('/theme_honzahauzr/static/src/img/cesta-hory.webp'); background-size: cover; background-position: center;">
                <div class="hh-final-cta__gradient"/>
                <div class="hh-final-cta__content">
                    <div class="container">
                        <div class="hh-final-cta__inner">
                            <h2 data-anim="fade-up">
                                Pojďme si nezávazně<br/><span class="hh-text-gradient">promluvit</span>
                            </h2>
                            <p class="hh-final-cta__sub" data-anim="fade-up" data-delay="150">
                                Úvodní hovor je zdarma a k ničemu tě nezavazuje. Řekneš mi, co řešíš,
                                a společně zjistíme, jestli ti umím pomoct. Ozvu se do 24 hodin.
                            </p>
                            <div data-anim="fade-up" data-delay="250">
                                <div class="hh-final-cta__urgency">Spolupráce začíná programem Tvůj tah &#8212; co obnáší, si vysvětlíme na hovoru.</div>
                            </div>
                            <form class="hh-form s_website_form" data-anim="fade-up" data-delay="350"
                                  action="/website/form/" method="post" enctype="multipart/form-data"
                                  data-model_name="crm.lead"
                                  data-success-mode="message">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="name" value="Úvodní hovor z webu honzahauzr.cz"/>
                                <!-- Obal s_website_form_field je povinny - Odoo validuje jen
                                     vstupy uvnitr nej. Bez obalu projde i prazdny formular. -->
                                <div class="s_website_form_field s_website_form_required">
                                    <label class="col-form-label s_website_form_label hh-sr-only" for="hh_jmeno">Tvé jméno</label>
                                    <input type="text" id="hh_jmeno" class="form-control s_website_form_input"
                                           name="contact_name" placeholder="Tvé jméno *" required="required" minlength="2"/>
                                     <span class="hh-err">Napiš prosím své jméno.</span>
                                </div>
                                <div class="s_website_form_field s_website_form_required">
                                    <label class="col-form-label s_website_form_label hh-sr-only" for="hh_email">Tvůj e-mail</label>
                                    <input type="email" id="hh_email" class="form-control s_website_form_input"
                                           name="email_from" placeholder="Tvůj e-mail *" required="required"/>
                                     <span class="hh-err">Bez e-mailu se ti nemám jak ozvat.</span>
                                </div>
                                <div class="s_website_form_field">
                                    <label class="col-form-label s_website_form_label hh-sr-only" for="hh_tel">Telefon</label>
                                    <input type="tel" id="hh_tel" class="form-control s_website_form_input"
                                           name="phone" placeholder="Telefon"/>
                                </div>
                                <div class="s_website_form_field">
                                    <label class="col-form-label s_website_form_label hh-sr-only" for="hh_zprava">Zpráva</label>
                                    <textarea id="hh_zprava" class="form-control s_website_form_input"
                                              name="description" placeholder="Co bys chtěl/a změnit? Napiš klidně jen pár vět." rows="3"/>
                                </div>
                                <button type="submit" class="hh-btn hh-btn--primary hh-btn--large s_website_form_send">
                                    Domluvit úvodní hovor
                                </button>
                            </form>
                            <!-- Odoo po odeslani sundá d-none. Musi byt sourozenec formulare. -->
                            <div class="s_website_form_end_message d-none hh-done">
                                <div class="hh-done__icon">
                                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>
                                </div>
                                <h3>Díky, mám to.</h3>
                                <p>Ozvu se ti do 24 hodin na e-mail, který jsi zadal.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 6. PDF ZDARMA -->
            <section class="hh-pdf o_cc o_colored_level" id="pdf">
                <div class="container">
                    <div class="hh-pdf__box" data-anim="fade-up">
                        <div>
                            <h3>Zatím nechceš mluvit?</h3>
                            <p>Pošlu ti PDF s tím, kde nejčastěji začínáme. Žádné navazující volání, jen e-mail.</p>
                        </div>
                        <form class="hh-pdf__form s_website_form"
                              action="/website/form/" method="post" enctype="multipart/form-data"
                              data-model_name="crm.lead"
                              data-success-mode="message">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="name" value="Stažení PDF z webu honzahauzr.cz"/>
                            <div class="s_website_form_field s_website_form_required">
                                <label class="col-form-label s_website_form_label hh-sr-only" for="hh_pdf_email">Tvůj e-mail</label>
                                <input type="email" id="hh_pdf_email" class="form-control s_website_form_input"
                                       name="email_from" placeholder="Tvůj e-mail" required="required"/>
                                 <span class="hh-err">Napiš e-mail, kam ti PDF poslat.</span>
                            </div>
                            <button type="submit" class="s_website_form_send">Poslat PDF</button>
                        </form>
                        <div class="s_website_form_end_message d-none hh-done hh-done--inline">
                            <div class="hh-done__icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>
                            </div>
                            <p>Hotovo, PDF ti posílám na e-mail.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 7. PATICKA -->
            <section class="hh-footer o_cc o_colored_level">
                <div class="container">
                    <div class="hh-footer__grid">
                        <div>
                            <div class="hh-footer__brand">Honza Hauzr</div>
                            <p>Osobní rozvoj, koučink a mentoring.<br/>Pomáhám lidem vrátit si směr a respekt k sobě.</p>
                        </div>
                        <div class="hh-footer__col">
                            <h4>Kontakt</h4>
                            <ul>
                                <li><a href="mailto:honzahauzr@gmail.com">honzahauzr@gmail.com</a></li>
                                <li><a href="#kontakt">Domluvit úvodní hovor</a></li>
                            </ul>
                        </div>
                        <div class="hh-footer__col">
                            <h4>Sledovat</h4>
                            <div class="hh-social">
                                <a href="https://www.instagram.com/honzahauzr.cz/" target="_blank" rel="noopener" class="hh-social__btn hh-social__btn--ig" aria-label="Instagram" title="Instagram">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.8" cy="6.2" r="1.2" fill="currentColor" stroke="none"/></svg>
                                </a>
                                <a href="https://www.facebook.com/honzahauzr.cz" target="_blank" rel="noopener" class="hh-social__btn hh-social__btn--fb" aria-label="Facebook" title="Facebook">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M14.5 8.5V6.9c0-.8.2-1.2 1.4-1.2h1.6V2.8C17.1 2.7 16.2 2.6 15.2 2.6c-2.4 0-4.1 1.5-4.1 4.2v1.7H8.4v3.1h2.7v8.8h3.4v-8.8h2.6l.4-3.1z"/></svg>
                                </a>
                                <a href="https://www.youtube.com/@HonzaHauzr_cz" target="_blank" rel="noopener" class="hh-social__btn hh-social__btn--yt" aria-label="YouTube" title="YouTube">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22.5 7.2a2.7 2.7 0 0 0-1.9-1.9C18.9 4.8 12 4.8 12 4.8s-6.9 0-8.6.5A2.7 2.7 0 0 0 1.5 7.2C1 8.9 1 12 1 12s0 3.1.5 4.8a2.7 2.7 0 0 0 1.9 1.9c1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5a2.7 2.7 0 0 0 1.9-1.9c.5-1.7.5-4.8.5-4.8s0-3.1-.5-4.8M9.8 15.3V8.7l5.7 3.3z"/></svg>
                                </a>
                                <a href="https://www.tiktok.com/@honzahauzr.cz" target="_blank" rel="noopener" class="hh-social__btn hh-social__btn--tt" aria-label="TikTok" title="TikTok">
